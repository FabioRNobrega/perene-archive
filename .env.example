# Optional: absolute path on the Docker host to the PereneArchive root.
# Defaults to /home/PereneArchive when unset, so most operators need no .env at all.
PERENE_ARCHIVE_ROOT=/home/PereneArchive

# Expected layout under PERENE_ARCHIVE_ROOT (created by the app if the host path is writable):
#   PERENE_ARCHIVE_ROOT/Videos
#   PERENE_ARCHIVE_ROOT/Pictures
#   PERENE_ARCHIVE_ROOT/Music
#   PERENE_ARCHIVE_ROOT/Documents
#   PERENE_ARCHIVE_ROOT/Books
#   PERENE_ARCHIVE_ROOT/Downloads
#   PERENE_ARCHIVE_ROOT/Shared
#   PERENE_ARCHIVE_ROOT/Family
#   PERENE_ARCHIVE_ROOT/History
#   PERENE_ARCHIVE_ROOT/Trash
#   PERENE_ARCHIVE_ROOT/Videos/Cuts                - exported A/B cuts
#   PERENE_ARCHIVE_ROOT/Videos/VideoComposition    - composed videos

# Optional: port used to open the application.
WEBAPP_PORT=8080

# Optional: comma-separated hostnames/IPs allowed in addition to localhost.
# Set this only in your private .env for NAS/LAN access, for example:
# ALLOWED_NETWORK_HOSTS=XXX.XXX.X.XXX
ALLOWED_NETWORK_HOSTS=

# Optional: host path to the Docker/Podman Engine API socket, bind-mounted read-only directly
# into the root webapp container so the System Dashboard can list/inspect sibling containers.
# Defaults to /var/run/docker.sock. On rootless Podman, set this to your user socket instead,
# for example: DASHBOARD_DOCKER_SOCKET=/run/user/1000/podman/podman.sock
DASHBOARD_DOCKER_SOCKET=/var/run/docker.sock

# Optional: HTTPS + HTTP/2 for LAN request streaming (see README "HTTPS / LAN request
# streaming"). Unset by default, in which case the app serves HTTP-only exactly as before.
#
# Comma/semicolon-separated LAN hostname(s)/IP(s) to include in the generated certificate's
# Subject Alternative Name list (localhost/127.0.0.1 are always included), for example:
# HTTPS_SAN_HOSTS=XXX.XXX.X.XXX
HTTPS_SAN_HOSTS=

# Password protecting the generated PFX. Required to run `make https-cert` and to enable the
# HTTPS endpoint; set this before running `make https-cert`.
HTTPS_CERT_PASSWORD=

# Optional: port used for the HTTPS endpoint once a certificate is configured.
HTTPS_WEBAPP_PORT=8443
