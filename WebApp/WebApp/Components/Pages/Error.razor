@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Diagnostics

<PageTitle>Perene Tech Videos — Error</PageTitle>

<section class="container py-5" aria-labelledby="error-heading">
    <div class="alert alert-danger" role="alert">
        <h1 id="error-heading" class="h2 alert-heading"><i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i>Something went wrong</h1>
        <p class="mb-0">Perene Tech Videos couldn’t complete this request. Return home or retry after checking the local configuration.</p>
        @if (ShowRequestId)
        {
            <hr />
            <p class="mb-0"><strong>Request ID:</strong> <code>@RequestId</code></p>
        }
    </div>
    <a class="btn btn-secondary d-inline-flex align-items-center gap-2" href="/">
        <i class="bi bi-house-door" aria-hidden="true"></i><span>Return home</span>
    </a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
