@inject HttpClient Http
@implements IDisposable

@if (_isUnavailable)
{
    <p class="small text-body-secondary mb-0">
        <i class="bi bi-hdd me-1" aria-hidden="true"></i>Storage unavailable
    </p>
}
else if (_usage is null)
{
    <p class="small text-body-secondary mb-0" aria-live="polite">
        <i class="bi bi-hdd me-1" aria-hidden="true"></i>Checking storage&hellip;
    </p>
}
else
{
    <div aria-live="polite">
        <div class="progress bg-success-subtle" role="progressbar"
             aria-label="Storage used"
             aria-valuenow="@_usedPercent"
             aria-valuemin="0"
             aria-valuemax="100"
             style="height: 6px;">
            <div class="progress-bar bg-primary" style="width: @(_usedPercent)%;"></div>
        </div>
        <p class="small text-body-secondary mb-0 mt-1">
            @FormatBytes(_usage.UsedBytes) of @FormatBytes(_usage.TotalBytes) used
        </p>
    </div>
}

@code {
    private StorageUsageDto? _usage;
    private bool _isUnavailable;
    private CancellationTokenSource? _cts;

    private int _usedPercent =>
        _usage is { TotalBytes: > 0 }
            ? (int)Math.Clamp(Math.Round(_usage.UsedBytes * 100.0 / _usage.TotalBytes), 0, 100)
            : 0;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        try
        {
            _usage = await Http.GetFromJsonAsync<StorageUsageDto>("api/storage/usage", _cts.Token);
            _isUnavailable = _usage is null;
        }
        catch (HttpRequestException)
        {
            _isUnavailable = true;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Disposal/replacement cancellation is not an availability failure.
        }
        catch (TaskCanceledException)
        {
            _isUnavailable = true;
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)Math.Max(0, bytes);
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
