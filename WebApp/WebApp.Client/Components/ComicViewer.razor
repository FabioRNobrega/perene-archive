@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<section class="comic-viewer card position-fixed top-0 start-0 w-100 h-100 overflow-hidden border-0 rounded-0 d-flex flex-column" aria-label="Comic viewer">
    @if (_toolbarCollapsed)
    {
        <button class="btn btn-secondary shadow comic-toolbar-show-button d-inline-flex align-items-center justify-content-center p-2" type="button" aria-label="Show comic toolbar" title="Show comic toolbar" @onclick="ShowToolbar"><i class="bi bi-arrow-bar-down" aria-hidden="true"></i></button>
    }
    <header class="comic-toolbar bg-body-tertiary border-bottom d-flex flex-wrap align-items-center gap-2 p-2 @(_toolbarCollapsed ? "d-none" : "")">
        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" aria-label="Back" title="Close comic" @onclick="ExitAsync"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <div class="btn-group" role="group" aria-label="Page navigation">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" disabled="@(!CanPrevious)" aria-label="Previous page" title="Previous page" @onclick="Previous"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" disabled="@(!CanNext)" aria-label="Next page" title="Next page" @onclick="Next"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
        <span class="d-none d-lg-inline fw-semibold text-truncate flex-grow-1 min-w-0" title="@(_comic?.Name)">@(_comic?.Name ?? "Comic")</span>
        <div class="btn-group ms-auto" role="group" aria-label="Page fit">
            <button class="btn @FitClass(true)" type="button" title="Fit page to viewport height" aria-pressed="@_fitHeight" @onclick="() => _fitHeight = true">Fit height</button>
            <button class="btn @FitClass(false)" type="button" title="Fit page to viewport width" aria-pressed="@(!_fitHeight)" @onclick="() => _fitHeight = false">Fit width</button>
        </div>
        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" aria-label="Hide comic toolbar" title="Hide comic toolbar" @onclick="HideToolbar"><i class="bi bi-arrow-bar-up" aria-hidden="true"></i></button>
    </header>
    <main class="comic-page flex-grow-1 position-relative d-flex align-items-center justify-content-center @(_fitHeight ? "comic-fit-height" : "comic-fit-width")">
        @if (_loading) { <span class="spinner-border" role="status"><span class="visually-hidden">Loading comic</span></span> }
        else if (_error is not null) { <div class="alert alert-danger">@_error</div> }
        else if (_comic?.PageCount == 0) { <div class="alert alert-warning">This comic has no readable pages.</div> }
        else { <button class="comic-tap-zone start-0" type="button" aria-label="Previous page" disabled="@(!CanPrevious)" @onclick="Previous"></button><img src="@PageUrl" alt="@Status" class="@( _fitHeight ? "fit-height" : "fit-width")" /><button class="comic-tap-zone end-0" type="button" aria-label="Next page" disabled="@(!CanNext)" @onclick="Next"></button> }
    </main>
    @if (_comic is not null && !_loading)
    {
        <footer class="comic-progress-footer border-top d-flex align-items-center justify-content-between gap-2 px-3 py-2" aria-label="Comic reading position">
            <span class="small fw-semibold text-body-secondary">Comic</span>
            <span role="status" aria-live="polite" class="small fw-semibold text-body-secondary text-nowrap">@Status</span>
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ItemId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnExit { get; set; }
    private readonly FillTabState _fillTab = new();
    private ComicBookDto? _comic; private int _index; private bool _loading = true; private bool _fitHeight = true; private bool _toolbarCollapsed; private string? _error;
    private IJSObjectReference? _module; private DotNetObjectReference<ComicViewer>? _reference;
    private bool CanPrevious => _index > 0; private bool CanNext => _comic is { } c && _index < c.PageCount - 1;
    private string Status => _comic is null ? "" : $"Page {_index + 1} of {_comic.PageCount}";
    private string PageUrl => $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic/pages/{_index}";
    protected override async Task OnInitializedAsync() { try { _comic = await Http.GetFromJsonAsync<ComicBookDto>($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic"); if (_comic is null) _error = "This comic could not be opened."; } catch { _error = "This comic could not be opened."; } finally { _loading = false; } }
    protected override async Task OnAfterRenderAsync(bool first) { if (!first) return; _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js"); _reference = DotNetObjectReference.Create(this); _fillTab.Select(ItemId); if (_fillTab.Enter()) { await _module.InvokeVoidAsync("enterFillTab", _reference); await _module.InvokeVoidAsync("addArrowKeyNavigation", _reference); } }
    [JSInvokable] public Task ExitFillTabFromEscapeAsync() => ExitAsync();
    [JSInvokable] public Task SelectPreviousFromKeyboardAsync() { Previous(); return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task SelectNextFromKeyboardAsync() { Next(); return InvokeAsync(StateHasChanged); }
    private void Previous() { if (CanPrevious) _index--; }
    private void Next() { if (CanNext) _index++; }
    private void ShowToolbar() => _toolbarCollapsed = false;
    private void HideToolbar() => _toolbarCollapsed = true;
    private string FitClass(bool height) => _fitHeight == height ? "btn-primary" : "btn-outline-secondary";
    private async Task ExitAsync() { _fillTab.Exit(); if (_module is not null) { await _module.InvokeVoidAsync("removeArrowKeyNavigation"); await _module.InvokeVoidAsync("exitFillTab"); } await OnExit.InvokeAsync(); }
    public async ValueTask DisposeAsync() { _reference?.Dispose(); if (_module is not null) { try { await _module.InvokeVoidAsync("removeArrowKeyNavigation"); await _module.InvokeVoidAsync("exitFillTab"); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
