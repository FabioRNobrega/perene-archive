@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<section @ref="_viewer" class="comic-viewer card position-fixed top-0 start-0 w-100 h-100 overflow-hidden border-0 rounded-0 d-flex flex-column" aria-label="Comic viewer">
    @if (_toolbarCollapsed)
    {
        <button class="comic-toolbar-reveal-zone" type="button" aria-label="Show comic toolbar" title="Show comic toolbar" @onclick="ShowToolbar"></button>
    }
    <header class="comic-toolbar bg-body-tertiary border-bottom d-flex flex-wrap align-items-center gap-2 p-2 @(_toolbarCollapsed ? "d-none" : "")">
        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" aria-label="Back" title="Close comic" @onclick="ExitAsync"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
        <div class="btn-group" role="group" aria-label="Page navigation">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" disabled="@(!CanPrevious)" aria-label="Previous page" title="Previous page" @onclick="Previous"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" disabled="@(!CanNext)" aria-label="Next page" title="Next page" @onclick="Next"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
        <span class="d-none d-lg-inline fw-semibold text-truncate flex-grow-1 min-w-0" title="@(_comic?.Name)">@(_comic?.Name ?? "Comic")</span>
        <div class="btn-group ms-auto" role="group" aria-label="Page fit">
            <button class="btn @FitClass(true)" type="button" title="Fit page to viewport height" aria-pressed="@_fitHeight" @onclick="() => _fitHeight = true">Fit height</button>
            <button class="btn @FitClass(false)" type="button" title="Fit page to viewport width" aria-pressed="@(!_fitHeight)" @onclick="() => _fitHeight = false">Fit width</button>
        </div>
        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                type="button"
                aria-label="@(_isFullscreen ? "Exit full screen" : "Full screen")"
                title="@(_isFullscreen ? "Exit full screen" : "Full screen")"
                aria-pressed="@_isFullscreen"
                @onclick="ToggleFullscreenAsync"><i class="bi @(_isFullscreen ? "bi-arrows-angle-contract" : "bi-arrows-angle-expand")" aria-hidden="true"></i></button>
        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2" type="button" aria-label="Hide comic toolbar" title="Hide comic toolbar" @onclick="HideToolbar"><i class="bi bi-arrow-bar-up" aria-hidden="true"></i></button>
    </header>
    <main class="comic-page flex-grow-1 position-relative d-flex align-items-center justify-content-center @(_fitHeight ? "comic-fit-height" : "comic-fit-width")">
        @if (_loading) { <span class="spinner-border" role="status"><span class="visually-hidden">Loading comic</span></span> }
        else if (_error is not null) { <div class="alert alert-danger">@_error</div> }
        else if (_comic?.PageCount == 0) { <div class="alert alert-warning">This comic has no readable pages.</div> }
        else { <button class="comic-tap-zone start-0" type="button" aria-label="Previous page" disabled="@(!CanPrevious)" @onclick="Previous"></button><img src="@PageUrl" alt="@Status" class="@( _fitHeight ? "fit-height" : "fit-width")" /><button class="comic-tap-zone end-0" type="button" aria-label="Next page" disabled="@(!CanNext)" @onclick="Next"></button> }
    </main>
    @if (_comic is not null && !_loading)
    {
        <footer class="comic-progress-footer border-top d-flex align-items-center justify-content-between gap-2 px-3 py-2" aria-label="Comic reading position">
            <span class="small fw-semibold text-body-secondary">Comic</span>
            <span role="status" aria-live="polite" class="small fw-semibold text-body-secondary text-nowrap">@Status</span>
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ItemId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnExit { get; set; }
    private readonly FillTabState _fillTab = new();
    private ComicBookDto? _comic; private int _index; private bool _loading = true; private bool _fitHeight = true; private bool _toolbarCollapsed; private string? _error;
    private IJSObjectReference? _module; private DotNetObjectReference<ComicViewer>? _reference; private ElementReference _viewer; private bool _isFullscreen;
    private CancellationTokenSource? _toolbarHideCts;
    private bool CanPrevious => _index > 0; private bool CanNext => _comic is { } c && _index < c.PageCount - 1;
    private string Status => _comic is null ? "" : $"Page {_index + 1} of {_comic.PageCount}";
    private string PageUrl => $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic/pages/{_index}";
    protected override async Task OnInitializedAsync() { try { _comic = await Http.GetFromJsonAsync<ComicBookDto>($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic"); if (_comic is null) _error = "This comic could not be opened."; else { var progress = await Http.GetFromJsonAsync<ComicProgressDto?>($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic/progress"); if (progress is not null && _comic.PageCount > 0) _index = Math.Clamp(progress.PageIndex, 0, _comic.PageCount - 1); } } catch { _error = "This comic could not be opened."; } finally { _loading = false; } }
    protected override async Task OnAfterRenderAsync(bool first) { if (!first) return; _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js"); _reference = DotNetObjectReference.Create(this); await _module.InvokeVoidAsync("registerVideoFullscreenChange", _viewer, _reference); _fillTab.Select(ItemId); if (_fillTab.Enter()) { await _module.InvokeVoidAsync("enterFillTab", _reference); await _module.InvokeVoidAsync("addArrowKeyNavigation", _reference); } ArmToolbarHideTimer(); }
    [JSInvokable] public Task ExitFillTabFromEscapeAsync() => ExitAsync();
    [JSInvokable] public async Task SelectPreviousFromKeyboardAsync() { await PreviousAsync(); await InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task SelectNextFromKeyboardAsync() { await NextAsync(); await InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task OnVideoFullscreenChanged(bool isFullscreen) { _isFullscreen = isFullscreen; return InvokeAsync(StateHasChanged); }
    private Task Previous() => NavigateAsync(-1);
    private Task Next() => NavigateAsync(1);
    private Task PreviousAsync() => NavigateAsync(-1);
    private Task NextAsync() => NavigateAsync(1);
    private async Task NavigateAsync(int direction) { if ((direction < 0 && !CanPrevious) || (direction > 0 && !CanNext)) return; _index += direction; try { using var response = await Http.PutAsJsonAsync($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/comic/progress", new ComicProgressDto(_index)); } catch (HttpRequestException) { } }
    private void ShowToolbar() { _toolbarCollapsed = false; ArmToolbarHideTimer(); }
    private void HideToolbar() => _toolbarCollapsed = true;
    private void ArmToolbarHideTimer()
    {
        _toolbarHideCts?.Cancel();
        _toolbarHideCts?.Dispose();
        _toolbarHideCts = new CancellationTokenSource();
        _ = HideToolbarAfterDelayAsync(_toolbarHideCts.Token);
    }
    private async Task HideToolbarAfterDelayAsync(CancellationToken cancellationToken)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken); _toolbarCollapsed = true; await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) { }
    }
    private string FitClass(bool height) => _fitHeight == height ? "btn-primary" : "btn-outline-secondary";
    private Task ToggleFullscreenAsync() => _module is null ? Task.CompletedTask : _module.InvokeVoidAsync("toggleVideoFullscreen", _viewer).AsTask();
    private async Task ExitAsync() { _fillTab.Exit(); if (_module is not null) { await _module.InvokeVoidAsync("removeArrowKeyNavigation"); await _module.InvokeVoidAsync("exitFillTab"); } await OnExit.InvokeAsync(); }
    public async ValueTask DisposeAsync() { _toolbarHideCts?.Cancel(); _toolbarHideCts?.Dispose(); _reference?.Dispose(); if (_module is not null) { try { await _module.InvokeVoidAsync("removeArrowKeyNavigation"); await _module.InvokeVoidAsync("exitFillTab"); await _module.InvokeVoidAsync("unregisterVideoFullscreenChange", _viewer); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
