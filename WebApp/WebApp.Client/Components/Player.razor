@using System.Globalization
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<section class="@EditorCssClass" aria-label="Video player">
    @if (Selected is null)
    {
        <div class="card-body d-flex flex-column align-items-center justify-content-center gap-2 py-5 my-5 text-center text-body-secondary"
             role="status">
            <i class="bi bi-aspect-ratio display-1 lh-1 text-primary mb-2" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No video selected</strong>
            <span>Scan the library and choose a clip to begin.</span>
        </div>
    }
    else
    {
        <div class="@PreviewStageCssClass">
            <div class="@MediaRowCssClass">
            <div class="@VideoViewportCssClass" style="@VideoViewportStyle" @ref="_viewport">
                @if (PlayerState.IsMusic)
                {
                    <div class="music-cover-stage position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark"
                         @onpointerdown="RevealControls"
                         @onmouseenter="HandleControlHoverStarted"
                         @onmouseleave="HandleControlHoverEnded">
                        @if (!string.IsNullOrWhiteSpace(PlayerState.AlbumCoverUrl))
                        {
                            <img src="@PlayerState.AlbumCoverUrl" alt="" class="@MusicCoverCssClass" />
                        }
                        else
                        {
                            <i class="bi bi-music-note-beamed display-1 lh-1 text-primary" aria-hidden="true"></i>
                        }
                    </div>
                    <audio @key="Selected.Id"
                           @ref="_video"
                           src="@MusicSource"
                           preload="metadata"
                           aria-label="Audio playback of @Selected.Name"
                           @onerror="ShowPlaybackError"
                           @onloadedmetadata="HandleLoadedMetadataAsync"
                           @ondurationchange="SynchronizeMediaStateAsync"
                           @onplay="SynchronizeMediaStateAsync"
                           @onpause="SynchronizeMediaStateAsync"
                           @ontimeupdate="HandleTimeUpdateAsync"
                           @onvolumechange="SynchronizeMediaStateAsync"
                           @onratechange="SynchronizeMediaStateAsync"
                           @onseeking="SynchronizeMediaStateAsync"
                           @onseeked="HandleSeekedAsync"
                           @onended="HandleEndedAsync">
                        Your browser does not support HTML5 audio.
                    </audio>
                }
                else
                {
                    <video @key="Selected.Id"
                           @ref="_video"
                           class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover user-select-none"
                           src="@VideoSource"
                           preload="metadata"
                           aria-label="Vertical preview of @Selected.Name"
                           style="@VideoStyle"
                           @onpointerdown="StartDragAsync"
                           @onpointermove="MoveDrag"
                           @onpointerup="args => EndDragAsync(args, revealControls: true)"
                           @onpointercancel="args => EndDragAsync(args, revealControls: false)"
                           @onpointerleave="args => EndDragAsync(args, revealControls: false)"
                           @onlostpointercapture="args => EndDragAsync(args, revealControls: false)"
                           @onerror="ShowPlaybackError"
                           @onloadedmetadata="HandleLoadedMetadataAsync"
                           @ondurationchange="SynchronizeMediaStateAsync"
                           @onplay="SynchronizeMediaStateAsync"
                           @onpause="SynchronizeMediaStateAsync"
                           @ontimeupdate="HandleTimeUpdateAsync"
                           @onvolumechange="SynchronizeMediaStateAsync"
                           @onratechange="SynchronizeMediaStateAsync"
                           @onseeking="SynchronizeMediaStateAsync"
                           @onseeked="HandleSeekedAsync"
                           @onended="HandleEndedAsync">
                        @if (HasSubtitles)
                        {
                            <track kind="subtitles"
                                   src="@SubtitleSource"
                                   srclang="en"
                                   label="English"
                                   default />
                        }
                        Your browser does not support HTML5 video.
                    </video>
                }
                @if (ShowOverlayControls && !PlayerState.IsMusic)
                {
                <div class="@SaturationRailCssClass"
                     aria-hidden="@(!_controlsVisible)"
                     @onmouseenter="HandleControlHoverStarted"
                     @onmouseleave="HandleControlHoverEnded">
                    <div class="btn-group" role="group" aria-label="Saturation actions">
                        <button class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center p-1 saturation-reset"
                                type="button"
                                disabled="@(_saturation.Value == SaturationState.Default)"
                                aria-label="Reset saturation"
                                title="Reset saturation"
                                @onclick="ResetSaturation">
                            <i class="bi bi-droplet-half" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="saturation-track position-relative">
                        <span class="saturation-fill position-absolute bottom-0 start-50 translate-middle-x" style="@SaturationFillStyle" aria-hidden="true"></span>
                        <input class="form-range saturation-range"
                               type="range"
                               min="0"
                               max="@Invariant(SaturationState.Max)"
                               step="1"
                               value="@Invariant(_saturation.Value)"
                               aria-label="Saturation"
                               @oninput="HandleSaturationInput" />
                    </div>
                    <output class="small text-white saturation-output" aria-hidden="true">@Math.Round(_saturation.Value)%</output>
                </div>
                }
                @if (ShowOverlayControls)
                {
                    @PlayerControls
                }
            </div>
            @if (!ShowOverlayControls)
            {
                <div class="@FooterCopyCssClass">
                    <p class="small fw-bold text-uppercase text-body-secondary mb-1">Now playing</p>
                    <p class="@NowPlayingNameCssClass">@FormatDisplayName(Selected)</p>
                    <p class="small text-body-secondary mb-0">@FormatMetadata(Selected)</p>
                </div>
            }
            </div>
            @if (_playbackError && !ShowOverlayControls)
            {
                <div class="alert alert-danger w-100 mt-3 mb-0 text-center" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    This browser can’t play the selected media. You can still select another item.
                </div>
            }
            @if (!ShowOverlayControls)
            {
                <div class="@PlayerControlsWrapperCssClass">
                    @PlayerControls
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public PersistentPlayerState PlayerState { get; set; } = default!;
    [Parameter] public PlayerPresentationMode Mode { get; set; } = PlayerPresentationMode.Footer;

    private const double DragThreshold = 6;
    private static readonly TimeSpan ControlHideDelay = TimeSpan.FromSeconds(1);

    private readonly VideoFrameState _frame = new();
    private readonly FillTabState _fillTab = new();
    private readonly MediaPlayerState _player = new();
    private readonly SaturationState _saturation = new();
    private ElementReference _viewport;
    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Player>? _dotNetReference;
    private CancellationTokenSource? _controlsHideCancellation;
    private DragSession? _drag;
    private bool _playbackError;
    private string? _playerError;
    private bool _pendingMediaInitialization;
    private bool _pendingFillTabCleanup;
    private int _fillTabFocusRequest;
    private bool _pendingControlsTimer;
    private bool _controlsVisible;
    private bool _controlInteractionActive;
    private bool _controlHoverActive;
    private bool _abSeekPending;
    private bool _isSavingCut;
    private bool _playAfterSelectionChange;
    private bool _audioTrackBusy;
    private double _pendingResumeTime;
    private bool _pendingResumePlaying;
    private bool _isFullscreen;
    private bool _disposed;

    private VideoItemDto? Selected => PlayerState.Selected;
    private string StreamBasePath => PlayerState.StreamBasePath;
    private RenderFragment PlayerControls => @<MediaPlayerControls State="_player"
                                                                   IsVisible="_controlsVisible"
                                                                   Error="@_playerError"
                                                                   TogglePlayback="TogglePlaybackAsync"
                                                                   Seek="SeekAsync"
                                                                   ToggleMute="ToggleMuteAsync"
                                                                   SetVolume="SetVolumeAsync"
                                                                   SetPlaybackRate="SetPlaybackRateAsync"
                                                                   ToggleStandardLoop="ToggleStandardLoopAsync"
                                                                   SkipBackward="SkipBackwardAsync"
                                                                   SkipForward="SkipForwardAsync"
                                                                   SetMarkerA="SetMarkerA"
                                                                   SetMarkerB="SetMarkerB"
                                                                   ToggleAbLoop="ToggleAbLoopAsync"
                                                                   SaveCut="SaveCutAsync"
                                                                   IsSavingCut="_isSavingCut"
                                                                   ClearAbLoop="ClearAbLoop"
                                                                   Stop="StopAsync"
                                                                   InteractionStarted="HandleControlInteractionStarted"
                                                                   InteractionEnded="HandleControlInteractionEnded"
                                                                   HoverStarted="HandleControlHoverStarted"
                                                                   HoverEnded="HandleControlHoverEnded"
                                                                   EnterFillTab="EnterFillTabAsync"
                                                                   IsFillTabActive="_fillTab.IsActive"
                                                                   ToggleFullscreen="ToggleFullscreenAsync"
                                                                   IsFullscreenActive="_isFullscreen"
                                                                   FillTabFocusRequest="_fillTabFocusRequest"
                                                                   HasSubtitles="HasSubtitles"
                                                                   ToggleSubtitles="ToggleSubtitlesAsync"
                                                                   HasMultipleAudioTracks="HasMultipleAudioTracks"
                                                                   AudioTracks="Selected?.AudioTracks"
                                                                   IsAudioTrackBusy="_audioTrackBusy"
                                                                   SelectAudioTrack="SelectAudioTrackAsync"
                                                                   CanSaveCut="PlayerState.CanSaveCut"
                                                                   IsMusicMode="PlayerState.IsMusic"
                                                                   HasPlaylist="PlayerState.HasPlaylist"
                                                                   ShowPlaylistButton="ShowPlaylistButton"
                                                                   OpenPlaylist="OpenPlaylist"
                                                                   SelectPreviousTrack="SelectPreviousTrackAsync"
                                                                   SelectNextTrack="SelectNextTrackAsync"
                                                                   CanSelectPreviousTrack="PlayerState.CanSelectPreviousTrack"
                                                                   CanSelectNextTrack="PlayerState.CanSelectNextTrack"
                                                                   IsFooterMode="@(!ShowOverlayControls)" />;

    private bool HasMultipleAudioTracks => !PlayerState.IsMusic && Selected?.AudioTracks?.Count > 1;
    private bool HasSubtitles => Selected?.SubtitleState == SubtitleState.Ready;
    private string SubtitleSource => Selected?.SubtitleUrl ?? $"{StreamBasePath}/{Selected?.Id}/subtitle";
    private string VideoSource => PlayerState.Playlist.FirstOrDefault(track => track.Id == Selected?.Id)?.SourceUrl
        ?? (_player.SelectedAudioTrackIndex is > 0
            ? $"{StreamBasePath}/{Selected?.Id}/stream?audio={_player.SelectedAudioTrackIndex}"
            : $"{StreamBasePath}/{Selected?.Id}/stream");

    private string MusicSource => PlayerState.Playlist.FirstOrDefault(track => track.Id == Selected?.Id)?.SourceUrl
        ?? $"{StreamBasePath}/{Selected?.Id}/audio";

    private bool IsPlaylistMode => Mode == PlayerPresentationMode.Playlist;

    private bool ShowOverlayControls => _fillTab.IsActive || _isFullscreen;

    private bool ShowPlaylistButton => PlayerState.CanReturnToPlaylist && !PlayerState.PlaylistViewActive;

    private void OpenPlaylist()
    {
        if (!PlayerState.CanReturnToPlaylist)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/playlist/{Uri.EscapeDataString(PlayerState.PlaylistCategory!)}/{Uri.EscapeDataString(PlayerState.PlaylistFolderId!)}");
    }

    private string EditorCssClass => _fillTab.IsActive
        ? "card position-fixed top-0 start-0 z-3 w-100 h-100 overflow-hidden border-0 rounded-0"
        : IsPlaylistMode
            ? "card w-100 h-100 min-h-0 overflow-hidden border-0 bg-body-tertiary"
            : "player-footer position-fixed start-0 end-0 bottom-0 z-3 bg-body border-top shadow-lg rounded-top-4 overflow-visible";

    private string PreviewStageCssClass => _fillTab.IsActive
        ? "w-100 h-100 p-0 bg-dark"
        : IsPlaylistMode
            ? "d-flex flex-column align-items-stretch gap-2 p-0 w-100 h-100 min-h-0"
            : "d-flex flex-column flex-lg-row align-items-stretch gap-3 px-3 py-2";

    private string MediaRowCssClass => _fillTab.IsActive
        ? "w-100 h-100"
        : IsPlaylistMode
            ? "playlist-player-media d-flex flex-column w-100 flex-grow-1 min-h-0"
            : "player-footer-media d-flex flex-row align-items-stretch gap-3 flex-grow-1 flex-lg-grow-0 flex-shrink-1 min-w-0";

    private string VideoViewportCssClass => _fillTab.IsActive || _isFullscreen
        ? "video-viewport position-relative w-100 h-100 overflow-hidden bg-dark"
        : IsPlaylistMode
            ? "video-viewport playlist-player-preview position-relative w-100 flex-grow-1 min-h-0 overflow-hidden bg-dark"
            : "video-viewport player-footer-preview ratio position-relative overflow-hidden bg-dark border rounded-3 flex-shrink-0";

    private string? VideoViewportStyle => _fillTab.IsActive || _isFullscreen || IsPlaylistMode
        ? null
        : "--bs-aspect-ratio: 56.25%";

    private string PlayerControlsWrapperCssClass => IsPlaylistMode
        ? "player-footer-controls w-100 min-w-0 flex-shrink-0 px-3 pb-3"
        : "player-footer-controls flex-grow-1 w-100 min-w-0";

    private string VideoStyle => FormattableString.Invariant(
        $"object-position: {_frame.PositionX:0.##}% {_frame.PositionY:0.##}%; touch-action: none; filter: saturate({_saturation.Value:0}%)");

    private string MusicCoverCssClass => _fillTab.IsActive
        ? "music-cover-image music-cover-fill object-fit-contain"
        : IsPlaylistMode
            ? "music-cover-image w-100 h-100 object-fit-contain"
            : "music-cover-image w-100 h-100 object-fit-cover";

    private string FooterCopyCssClass => IsPlaylistMode
        ? "w-100 px-3 pt-2 pb-2 min-w-0 flex-shrink-0"
        : PlayerState.IsMusic
            ? "player-footer-copy player-footer-copy-music flex-grow-1 flex-shrink-0 min-w-0"
            : "player-footer-copy flex-grow-1 flex-lg-grow-0 flex-shrink-1 min-w-0";

    private string NowPlayingNameCssClass => PlayerState.IsMusic
        ? "fw-semibold text-nowrap mb-1"
        : "fw-semibold text-break mb-1";

    private string SaturationFillStyle =>
        $"height: {Invariant(Math.Clamp(_saturation.Value / SaturationState.Max * 100, 0, 100))}%";

    private string SaturationRailCssClass =>
        $"saturation-rail position-absolute top-50 translate-middle-y z-3 d-flex flex-column align-items-center gap-2 text-white user-select-none {(_controlsVisible ? "is-visible visible opacity-100 pe-auto" : "invisible opacity-0 pe-none")}";

    protected override void OnParametersSet()
    {
        if (!string.Equals(_frame.SelectionId, Selected?.Id, StringComparison.Ordinal))
        {
            HandleSelectionChanged();
        }
    }

    private void HandleSelectionChanged()
    {
        _frame.Select(Selected?.Id);
        _player.Select(Selected?.Id);
        _saturation.Select(Selected?.Id);
        _pendingFillTabCleanup |= _fillTab.Select(Selected?.Id);
        _drag = null;
        _playbackError = false;
        _playerError = null;
        _isSavingCut = false;
        _abSeekPending = false;
        _pendingResumeTime = PlayerState.LastKnownTime;
        _pendingResumePlaying = PlayerState.WasPlaying;
        _pendingMediaInitialization = Selected is not null;
        _playAfterSelectionChange = Selected is not null && _pendingResumeTime <= 0;
        _controlsVisible = Selected is not null;
        _pendingControlsTimer = Selected is not null;
        _controlInteractionActive = false;
        _controlHoverActive = false;
        CancelControlsHideTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js");
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerVideoFullscreenChange", _viewport, _dotNetReference);
        }

        if (_module is not null && _pendingFillTabCleanup)
        {
            await _module.InvokeVoidAsync("exitFillTab");
            _pendingFillTabCleanup = false;
        }

        if (_module is not null && Selected is not null && _pendingMediaInitialization)
        {
            _pendingMediaInitialization = false;
            await ApplyPlayerPreferencesAsync();
            if (_playAfterSelectionChange)
            {
                _playAfterSelectionChange = false;
                await ExecuteMediaCommandAsync("playVideo");
            }
        }

        if (_pendingControlsTimer && Selected is not null)
        {
            _pendingControlsTimer = false;
            ArmControlsHideTimer();
        }

    }

    private async Task EnterFillTabAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (_fillTab.IsActive)
        {
            await ExitFillTabAsync();
            return;
        }

        if (!_fillTab.Enter())
        {
            return;
        }

        _dotNetReference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("enterFillTab", _dotNetReference);
    }

    [JSInvokable]
    public Task ExitFillTabFromEscapeAsync() => ExitFillTabAsync();

    private Task ToggleFullscreenAsync()
    {
        if (_module is null || Selected is null)
        {
            return Task.CompletedTask;
        }

        return _module.InvokeVoidAsync("toggleVideoFullscreen", _viewport).AsTask();
    }

    [JSInvokable]
    public async Task OnVideoFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExitFillTabAsync()
    {
        var exited = _fillTab.Exit();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("exitFillTab");
        }

        if (exited)
        {
            _fillTabFocusRequest++;
            RevealControls();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartDragAsync(PointerEventArgs args)
    {
        if (PlayerState.IsMusic || _module is null || Selected is null || !_fillTab.IsActive || !args.IsPrimary)
        {
            return;
        }

        var geometry = await _module.InvokeAsync<VideoGeometry>(
            "measureAndCapture", _viewport, _video, args.PointerId);
        _drag = new DragSession(args.PointerId, args.ClientX, args.ClientY,
            _frame.PositionX, _frame.PositionY, geometry);
    }

    private void MoveDrag(PointerEventArgs args)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        var deltaX = args.ClientX - _drag.StartClientX;
        var deltaY = args.ClientY - _drag.StartClientY;
        _drag.HasMoved |= Math.Sqrt((deltaX * deltaX) + (deltaY * deltaY)) >= DragThreshold;
        if (!_drag.HasMoved)
        {
            return;
        }

        _frame.ApplyDrag(_drag.StartPositionX, _drag.StartPositionY,
            deltaX, deltaY,
            _drag.Geometry.ViewportWidth, _drag.Geometry.ViewportHeight,
            _drag.Geometry.VideoWidth, _drag.Geometry.VideoHeight);
    }

    private async Task EndDragAsync(PointerEventArgs args, bool revealControls)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        var completedDrag = _drag;
        _drag = null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releasePointer", _video, args.PointerId);
        }

        if (revealControls && !completedDrag.HasMoved)
        {
            RevealControls();
        }
    }

    private void Reset() => _frame.Reset();
    private void ShowPlaybackError() => _playbackError = true;

    private void HandleSaturationInput(ChangeEventArgs args)
    {
        if (double.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), NumberStyles.Float,
                CultureInfo.InvariantCulture, out var value))
        {
            _saturation.SetValue(value);
        }
    }

    private void ResetSaturation() => _saturation.Reset();

    private static string Invariant(double value) => value.ToString("0", CultureInfo.InvariantCulture);

    private async Task HandleLoadedMetadataAsync()
    {
        _playbackError = false;

        if (_pendingResumeTime > 0)
        {
            var resumeTime = _pendingResumeTime;
            var resumePlaying = _pendingResumePlaying;
            _pendingResumeTime = 0;
            _pendingResumePlaying = false;

            await ExecuteMediaCommandAsync("setPlaybackRate", _player.PlaybackRate);
            await ExecuteMediaCommandAsync("seekVideo", resumeTime);
            if (resumePlaying)
            {
                await ExecuteMediaCommandAsync("playVideo");
            }

            await SynchronizeMediaStateAsync();
        }
    }

    private async Task SelectAudioTrackAsync(int index)
    {
        if (!HasMultipleAudioTracks || _audioTrackBusy || Selected is null ||
            index == (_player.SelectedAudioTrackIndex ?? 0))
        {
            return;
        }

        var selectionId = Selected.Id;
        if (index > 0)
        {
            _audioTrackBusy = true;
            StateHasChanged();
            var state = await PrepareAudioTrackAsync(selectionId, index);
            _audioTrackBusy = false;
            if (!string.Equals(Selected?.Id, selectionId, StringComparison.Ordinal) || _disposed)
            {
                return;
            }

            if (state != "Ready")
            {
                ShowPlayerCommandError();
                return;
            }
        }

        _pendingResumeTime = _player.CurrentTime;
        _pendingResumePlaying = _player.IsPlaying;
        _playerError = null;
        _player.SetSelectedAudioTrack(index);
        StateHasChanged();
    }

    private async Task<string> PrepareAudioTrackAsync(string selectionId, int index)
    {
        var url = $"{StreamBasePath}/{Uri.EscapeDataString(selectionId)}/audio-tracks/{index}";
        try
        {
            while (!_disposed && string.Equals(Selected?.Id, selectionId, StringComparison.Ordinal))
            {
                using var response = await Http.PostAsync(url, content: null);
                if (!response.IsSuccessStatusCode)
                {
                    return "Failed";
                }

                var payload = await response.Content.ReadFromJsonAsync<AudioTrackPrepareResponse>();
                if (payload?.State is "Ready" or "Failed")
                {
                    return payload.State;
                }

                await Task.Delay(TimeSpan.FromSeconds(1));
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
        }

        return "Failed";
    }

    private async Task ApplyPlayerPreferencesAsync()
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("setVolume", _video, _player.Volume);
            await _module.InvokeVoidAsync("setMuted", _video, _player.IsMuted);
            await _module.InvokeVoidAsync("setPlaybackRate", _video, _player.PlaybackRate);
            await _module.InvokeVoidAsync("setLoop", _video, false);
            if (!PlayerState.IsMusic)
            {
                await _module.InvokeVoidAsync("setSubtitlesEnabled", _video, HasSubtitles && _player.IsSubtitlesEnabled);
            }
            await SynchronizeMediaStateAsync();
        }
        catch (JSException)
        {
            ShowPlayerCommandError();
        }
    }

    private async Task SynchronizeMediaStateAsync()
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        var snapshot = await _module.InvokeAsync<MediaSnapshot>("readMediaSnapshot", _video);
        _player.Synchronize(snapshot);
        PlayerState.UpdatePlaybackProgress(_player.CurrentTime, _player.IsPlaying);
    }

    private async Task HandleTimeUpdateAsync()
    {
        await SynchronizeMediaStateAsync();
        if (PlayerState.IsMusic || _module is null || _abSeekPending || !_player.TryMoveToAbStart(out var target))
        {
            return;
        }

        _abSeekPending = true;
        await ExecuteMediaCommandAsync("seekVideo", target);
    }

    private async Task HandleSeekedAsync()
    {
        _abSeekPending = false;
        await SynchronizeMediaStateAsync();
    }

    private async Task HandleEndedAsync()
    {
        await SynchronizeMediaStateAsync();
        if (PlayerState.HasPlaylist && PlayerState.CanSelectNextTrack)
        {
            await SelectNextTrackAsync();
        }
    }

    private Task TogglePlaybackAsync() => ExecuteMediaCommandAsync(
        _player.IsPlaying ? "pauseVideo" : "playVideo");

    private async Task SeekAsync(double value)
    {
        _player.PreviewTime(value);
        await ExecuteMediaCommandAsync("seekVideo", _player.CurrentTime);
    }

    private const double SkipSeconds = 10;

    private Task SkipBackwardAsync() => SeekAsync(_player.CurrentTime - SkipSeconds);

    private Task SkipForwardAsync() => SeekAsync(_player.CurrentTime + SkipSeconds);

    private Task ToggleMuteAsync() => ExecuteMediaCommandAsync("setMuted", !_player.IsMuted);

    private Task SetVolumeAsync(double value) =>
        ExecuteMediaCommandAsync("setVolume", Math.Clamp(value, 0, 1));

    private Task SetPlaybackRateAsync(double value) =>
        ExecuteMediaCommandAsync("setPlaybackRate", value);

    private async Task ToggleStandardLoopAsync()
    {
        _player.SetStandardLoop(!_player.IsStandardLoop);
        await ExecuteMediaCommandAsync("setLoop", _player.IsStandardLoop);
        await SynchronizeMediaStateAsync();
    }

    private async Task ToggleSubtitlesAsync()
    {
        if (PlayerState.IsMusic || !HasSubtitles)
        {
            return;
        }

        _player.SetSubtitlesEnabled(!_player.IsSubtitlesEnabled);
        await ExecuteMediaCommandAsync("setSubtitlesEnabled", _player.IsSubtitlesEnabled);
    }

    private void SetMarkerA() => _player.SetMarkerA();
    private void SetMarkerB() => _player.SetMarkerB();

    private async Task ToggleAbLoopAsync()
    {
        var enable = !_player.IsAbLoop;
        if (!_player.SetAbLoop(enable))
        {
            return;
        }

        if (enable)
        {
            await ExecuteMediaCommandAsync("setLoop", false);
            await SynchronizeMediaStateAsync();
        }
    }

    private async Task SaveCutAsync()
    {
        if (!PlayerState.CanSaveCut || Selected is null || !_player.HasValidAbRange || _player.MarkerA is null || _player.MarkerB is null || _isSavingCut)
        {
            return;
        }

        try
        {
            _isSavingCut = true;
            _playerError = null;
            using var response = await Http.PostAsJsonAsync(
                $"api/videos/{Selected.Id}/cuts",
                new CutRequest(_player.MarkerA.Value, _player.MarkerB.Value));

            if (!response.IsSuccessStatusCode)
            {
                _isSavingCut = false;
                _playerError = "The cut could not be queued. Check the A/B points and try again.";
                RevealControls();
                return;
            }

            _isSavingCut = false;
            PlayerState.NotifyCutQueued();
        }
        catch (HttpRequestException)
        {
            _isSavingCut = false;
            _playerError = "The cut service could not be reached. Try again.";
            RevealControls();
        }
        catch (TaskCanceledException)
        {
            _isSavingCut = false;
            _playerError = "The cut request was interrupted. Try again.";
            RevealControls();
        }
    }

    private void ClearAbLoop() => _player.ClearAbLoop();

    private static readonly Dictionary<string, string> CategoryRoutes = new(StringComparer.OrdinalIgnoreCase);

    private async Task StopAsync()
    {
        await ExecuteMediaCommandAsync("pauseVideo");
        if (_fillTab.IsActive)
        {
            await ExitFillTabAsync();
        }

        var returnCategory = PlayerState.PlaylistViewActive ? PlayerState.PlaylistCategory : null;
        PlayerState.Clear();

        if (!string.IsNullOrWhiteSpace(returnCategory))
        {
            Navigation.NavigateTo(CategoryRoutes.TryGetValue(returnCategory, out var route) ? route : $"/{returnCategory}");
        }
    }

    private async Task SelectPreviousTrackAsync()
    {
        if (PlayerState.SelectPreviousTrack())
        {
            _playAfterSelectionChange = true;
            _pendingMediaInitialization = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectNextTrackAsync()
    {
        if (PlayerState.SelectNextTrack())
        {
            _playAfterSelectionChange = true;
            _pendingMediaInitialization = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatDisplayName(VideoItemDto item) =>
        item.Extension.Length > 0 && item.Name.EndsWith(item.Extension, StringComparison.OrdinalIgnoreCase)
            ? item.Name[..^item.Extension.Length]
            : item.Name;

    private static string FormatMetadata(VideoItemDto item)
    {
        var parts = new List<string>();
        if (item.DurationSeconds is > 0)
        {
            parts.Add(MediaPlayerState.FormatTime(item.DurationSeconds.Value));
        }

        if (item.Height is > 0)
        {
            parts.Add($"{item.Height}p");
        }

        parts.Add(item.Extension.TrimStart('.').ToUpperInvariant());
        return string.Join(" · ", parts);
    }

    private async Task ExecuteMediaCommandAsync(string identifier, params object?[] values)
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        var arguments = new object?[values.Length + 1];
        arguments[0] = _video;
        Array.Copy(values, 0, arguments, 1, values.Length);

        try
        {
            _playerError = null;
            await _module.InvokeVoidAsync(identifier, arguments);
        }
        catch (JSException)
        {
            ShowPlayerCommandError();
        }
    }

    private void ShowPlayerCommandError()
    {
        _playerError = "The browser couldn’t complete that media command. Try again or choose another clip.";
        RevealControls();
    }

    private void HandleControlInteractionStarted()
    {
        _controlInteractionActive = true;
        _controlsVisible = true;
        CancelControlsHideTimer();
    }

    private void HandleControlInteractionEnded()
    {
        _controlInteractionActive = false;
        ArmControlsHideTimer();
    }

    private void HandleControlHoverStarted()
    {
        _controlHoverActive = true;
        _controlsVisible = true;
        CancelControlsHideTimer();
    }

    private void HandleControlHoverEnded()
    {
        _controlHoverActive = false;
        ArmControlsHideTimer();
    }

    private void RevealControls()
    {
        _controlsVisible = true;
        ArmControlsHideTimer();
    }

    private void ArmControlsHideTimer()
    {
        CancelControlsHideTimer();
        if (_disposed || Selected is null || !_fillTab.IsActive || _controlInteractionActive || _controlHoverActive)
        {
            return;
        }

        _controlsHideCancellation = new CancellationTokenSource();
        _ = HideControlsAfterDelayAsync(_controlsHideCancellation.Token);
    }

    private async Task HideControlsAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(ControlHideDelay, cancellationToken);
            await InvokeAsync(() =>
            {
                if (!_controlInteractionActive && !_controlHoverActive)
                {
                    _controlsVisible = false;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelControlsHideTimer()
    {
        _controlsHideCancellation?.Cancel();
        _controlsHideCancellation?.Dispose();
        _controlsHideCancellation = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelControlsHideTimer();
        _fillTab.Exit();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("exitFillTab");
                await _module.InvokeVoidAsync("unregisterVideoFullscreenChange", _viewport);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
    }

    private sealed record VideoGeometry(double ViewportWidth, double ViewportHeight, double VideoWidth, double VideoHeight);

    private sealed record CutRequest(double Start, double End);

    private sealed class DragSession(long pointerId, double startClientX, double startClientY,
        double startPositionX, double startPositionY, VideoGeometry geometry)
    {
        public long PointerId { get; } = pointerId;
        public double StartClientX { get; } = startClientX;
        public double StartClientY { get; } = startClientY;
        public double StartPositionX { get; } = startPositionX;
        public double StartPositionY { get; } = startPositionY;
        public VideoGeometry Geometry { get; } = geometry;
        public bool HasMoved { get; set; }
    }
}
