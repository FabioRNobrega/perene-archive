@inject AccountApiClient Accounts

<section class="card border h-100" aria-labelledby="password-card-title">
    <div class="card-body">
        <h2 id="password-card-title" class="h5 card-title">Password</h2>
        <p class="text-body-secondary">Choose a new password for your account.</p>
        @if (!string.IsNullOrEmpty(_message)) { <div class="alert alert-success" role="status">@_message</div> }
        @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
        <label class="form-label" for="current-password">Current password</label>
        <PasswordInput Id="current-password" Class="mb-3" Autocomplete="current-password" @bind-Value="_currentPassword" />
        <label class="form-label" for="new-password">New password</label>
        <PasswordInput Id="new-password" Autocomplete="new-password" @bind-Value="_newPassword" />
        <button class="btn btn-secondary mt-3" disabled="@_busy" @onclick="ChangePasswordAsync">Change password</button>
    </div>
</section>

@code {
    private string _currentPassword = "", _newPassword = "";
    private string? _message, _error;
    private bool _busy;

    private async Task ChangePasswordAsync()
    {
        _message = _error = null;
        _busy = true;
        try
        {
            await Accounts.PostAsync("api/account/change-password", new ChangePasswordDto(_currentPassword, _newPassword));
            _currentPassword = _newPassword = "";
            _message = "Password changed.";
        }
        catch (HttpRequestException)
        {
            _error = "The password could not be changed. Check your details and try again.";
        }
        finally { _busy = false; }
    }
}
