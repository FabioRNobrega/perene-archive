<div class="input-group @Class">
    <input id="@Id" class="form-control" type="@(_visible ? "text" : "password")" autocomplete="@Autocomplete" value="@Value" @oninput="OnInput" />
    <button type="button" class="btn btn-outline-secondary px-3 py-2" aria-controls="@Id" aria-pressed="@(_visible ? "true" : "false")" aria-label="@Label" title="@Label" @onclick="() => _visible = !_visible">
        <i class="bi @(_visible ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "off";
    [Parameter] public string? Class { get; set; }

    private bool _visible;
    private string Label => _visible ? "Hide password" : "Show password";

    private Task OnInput(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
