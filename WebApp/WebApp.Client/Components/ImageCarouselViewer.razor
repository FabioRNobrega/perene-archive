@using System.Globalization
@using System.Net
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http

<section class="image-carousel-viewer card position-fixed top-0 start-0 w-100 h-100 overflow-hidden border-0 rounded-0 bg-dark"
         aria-label="Image viewer">
    <div class="carousel slide w-100 h-100 @(_zoom > ZoomDefault ? "zoomable" : null)"
         data-bs-interval="false"
         @ref="_viewport"
         @onmouseenter="HandleControlHoverStarted"
         @onmouseleave="HandleControlHoverEnded"
         @onpointerdown="StartPanAsync"
         @onpointermove="MovePan"
         @onpointerup="EndPanAsync"
         @onpointercancel="EndPanAsync"
         @onpointerleave="EndPanAsync"
         @onlostpointercapture="EndPanAsync">
        <div class="carousel-inner w-100 h-100">
            @for (var index = 0; index < Images.Count; index++)
            {
                var image = Images[index];
                <div class="carousel-item w-100 h-100 @(index == _currentIndex ? "active" : null)">
                    <img src="@image.ImageUrl"
                         alt="@image.Name"
                         class="d-block w-100 h-100 object-fit-contain user-select-none"
                         style="@ImageStyle"
                         draggable="false"
                         @ondragstart:preventDefault="true" />
                </div>
            }
        </div>
        @if (_cropMode && _cropRect is not null && _cropImageBounds is not null)
        {
            var bounds = _cropImageBounds;
            var rect = _cropRect;
            <div class="crop-overlay position-absolute" style="@CropOverlayContainerStyle(bounds)">
                <div class="crop-rect position-absolute"
                     style="@CropRectStyle(rect)"
                     @onpointerdown="args => StartCropDragAsync(CropHandle.Body, args)"
                     @onpointerdown:stopPropagation="true">
                    <div class="crop-handle crop-handle-nw" @onpointerdown="args => StartCropDragAsync(CropHandle.NW, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-n" @onpointerdown="args => StartCropDragAsync(CropHandle.N, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-ne" @onpointerdown="args => StartCropDragAsync(CropHandle.NE, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-e" @onpointerdown="args => StartCropDragAsync(CropHandle.E, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-se" @onpointerdown="args => StartCropDragAsync(CropHandle.SE, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-s" @onpointerdown="args => StartCropDragAsync(CropHandle.S, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-sw" @onpointerdown="args => StartCropDragAsync(CropHandle.SW, args)" @onpointerdown:stopPropagation="true"></div>
                    <div class="crop-handle crop-handle-w" @onpointerdown="args => StartCropDragAsync(CropHandle.W, args)" @onpointerdown:stopPropagation="true"></div>
                </div>
                <div class="crop-actions d-flex gap-2 position-absolute" style="@CropActionsStyle(rect)" @onpointerdown:stopPropagation="true">
                    <button class="btn btn-success btn-sm d-inline-flex align-items-center justify-content-center p-2"
                            type="button"
                            disabled="@_cropSaving"
                            aria-label="Confirm crop"
                            title="Confirm crop"
                            @onclick="ConfirmCropAsync">
                        <i class="bi bi-check-square-fill" aria-hidden="true"></i>
                    </button>
                    <button class="btn btn-outline-light btn-sm d-inline-flex align-items-center justify-content-center p-2"
                            type="button"
                            disabled="@_cropSaving"
                            aria-label="Cancel crop"
                            title="Cancel crop"
                            @onclick="CancelCrop">
                        <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        }
        @if (_cropMode && _cropError is not null)
        {
            <div class="crop-error alert alert-danger position-absolute m-2 py-1 px-2 small" role="alert">@_cropError</div>
        }
        <div class="image-carousel-controls d-flex flex-column gap-2 text-white user-select-none @(_controlsVisible ? "is-visible visible opacity-100 pe-auto" : "invisible opacity-0 pe-none")"
             aria-hidden="@(!_controlsVisible)"
             @onmouseenter="HandleControlHoverStarted"
             @onmouseleave="HandleControlHoverEnded"
             @onpointerdown:stopPropagation="true">
            <div class="btn-toolbar d-flex flex-wrap align-items-center gap-2 pt-2" role="toolbar" aria-label="Image viewer controls">
                <div class="btn-group" role="group" aria-label="Navigate">
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(!CanSelectPrevious || _cropMode)"
                            aria-label="Previous image"
                            title="Previous image"
                            @onclick="SelectPrevious">
                        <i class="bi bi-chevron-compact-left" aria-hidden="true"></i>
                    </button>
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(!CanSelectNext || _cropMode)"
                            aria-label="Next image"
                            title="Next image"
                            @onclick="SelectNext">
                        <i class="bi bi-chevron-compact-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="btn-group" role="group" aria-label="Zoom">
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(_zoom <= ZoomMin || _cropMode)"
                            aria-label="Zoom out"
                            title="Zoom out"
                            @onclick="ZoomOut">
                        <i class="bi bi-zoom-out" aria-hidden="true"></i>
                    </button>
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(_zoom == ZoomDefault || _cropMode)"
                            aria-label="Reset zoom"
                            title="Reset zoom"
                            @onclick="ResetZoom">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    </button>
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(_zoom >= ZoomMax || _cropMode)"
                            aria-label="Zoom in"
                            title="Zoom in"
                            @onclick="ZoomIn">
                        <i class="bi bi-zoom-in" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="btn-group" role="group" aria-label="Saturation actions">
                    <button class="btn @ActionCssClass"
                            type="button"
                            disabled="@(_saturation.Value == SaturationState.Default || _cropMode)"
                            aria-label="Reset saturation"
                            title="Reset saturation"
                            @onclick="ResetSaturation">
                        <i class="bi bi-droplet-half" aria-hidden="true"></i>
                    </button>
                </div>
                <label class="saturation-control d-flex align-items-center gap-2">
                    <span class="visually-hidden">Saturation</span>
                    <input class="form-range w-100 m-0"
                           type="range"
                           min="0"
                           max="@Invariant(SaturationState.Max)"
                           step="1"
                           value="@Invariant(_saturation.Value)"
                           style="@SaturationProgressStyle"
                           disabled="@_cropMode"
                           aria-label="Saturation"
                           @oninput="HandleSaturationInput" />
                    <output class="small text-nowrap" aria-hidden="true">@Math.Round(_saturation.Value)%</output>
                </label>

                <div class="btn-group" role="group" aria-label="Crop">
                    <button class="btn @ToggleCssClass(_cropMode)"
                            type="button"
                            disabled="@(!CanCropCurrentImage)"
                            aria-label="Crop image"
                            title="Crop image"
                            aria-pressed="@_cropMode"
                            aria-describedby="@CropDescriptionId"
                            @onclick="ToggleCropModeAsync">
                        <i class="bi bi-scissors" aria-hidden="true"></i>
                    </button>
                </div>
                @if (!CanCropCurrentImage)
                {
                    <span id="crop-unavailable" class="small text-white-50" role="status">Cropping is available only for JPEG and PNG images.</span>
                }

                <div class="btn-group ms-auto" role="group" aria-label="Exit">
                    <button class="btn @ToggleCssClass(true)"
                            type="button"
                            aria-label="Exit fill browser tab"
                            title="Exit fill browser tab"
                            @onclick="ExitAsync">
                        <i class="bi bi-arrow-bar-down" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int ControlHideDelaySeconds = 1;
    private const double ZoomDefault = 1;
    private const double ZoomMin = 1;
    private const double ZoomMax = 3;
    private const double ZoomStep = 0.25;
    private const double CropMinSizePercent = 5;
    private const string ActionCssClass = "btn-outline-primary d-inline-flex align-items-center justify-content-center p-2";
    private static readonly CropRect DefaultCropRect = new(20, 20, 60, 60);

    [Parameter, EditorRequired] public IReadOnlyList<ArchiveItemDto> Images { get; set; } = [];
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter] public string? StartId { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private readonly FillTabState _fillTab = new();
    private readonly SaturationState _saturation = new();
    private IJSObjectReference? _module;
    private DotNetObjectReference<ImageCarouselViewer>? _dotNetReference;
    private CancellationTokenSource? _controlsHideCancellation;
    private ElementReference _viewport;
    private PanSession? _pan;
    private int _currentIndex;
    private double _zoom = ZoomDefault;
    private double _panX;
    private double _panY;
    private bool _controlsVisible = true;
    private bool _controlHoverActive;
    private bool _disposed;
    private bool _cropMode;
    private bool _cropSaving;
    private string? _cropError;
    private CropRect? _cropRect;
    private ImageRenderBounds? _cropImageBounds;
    private CropDragSession? _cropDrag;

    private bool CanSelectPrevious => _currentIndex > 0;
    private bool CanSelectNext => _currentIndex < Images.Count - 1;
    private bool CanCropCurrentImage => Images.Count > 0 && IsCropSupported(Images[_currentIndex].Name);
    private string? CropDescriptionId => CanCropCurrentImage ? null : "crop-unavailable";
    private string SaturationProgressStyle =>
        $"--saturation-progress: {Invariant(Math.Clamp(_saturation.Value / SaturationState.Max * 100, 0, 100))}%";

    private string ImageStyle => FormattableString.Invariant(
        $"transform: translate({_panX:0.##}px, {_panY:0.##}px) scale({_zoom:0.##}); filter: saturate({_saturation.Value:0}%); transition: {(_pan is null ? "transform .2s ease" : "none")};");

    protected override void OnParametersSet()
    {
        var index = Images.ToList().FindIndex(image => string.Equals(image.Id, StartId, StringComparison.Ordinal));
        SelectIndex(index >= 0 ? index : 0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js");
            _fillTab.Select(StartId);
            if (_fillTab.Enter())
            {
                _dotNetReference ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("enterFillTab", _dotNetReference);
                await _module.InvokeVoidAsync("addArrowKeyNavigation", _dotNetReference);
                ArmControlsHideTimer();
            }
        }
    }

    [JSInvokable]
    public async Task ExitFillTabFromEscapeAsync() => await ExitAsync();

    [JSInvokable]
    public async Task SelectPreviousFromKeyboardAsync()
    {
        SelectPrevious();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task SelectNextFromKeyboardAsync()
    {
        SelectNext();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExitAsync()
    {
        CancelControlsHideTimer();
        _fillTab.Exit();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("removeArrowKeyNavigation");
            await _module.InvokeVoidAsync("exitFillTab");
        }

        await OnExit.InvokeAsync();
    }

    private void SelectIndex(int index)
    {
        _currentIndex = index;
        _zoom = ZoomDefault;
        _panX = 0;
        _panY = 0;
        _saturation.Select(Images.Count > 0 ? Images[_currentIndex].Id : null);
        ExitCropModeState();
    }

    private void SelectPrevious()
    {
        if (!CanSelectPrevious)
        {
            return;
        }

        SelectIndex(_currentIndex - 1);
        RevealControls();
    }

    private void SelectNext()
    {
        if (!CanSelectNext)
        {
            return;
        }

        SelectIndex(_currentIndex + 1);
        RevealControls();
    }

    private void ZoomIn()
    {
        if (_cropMode)
        {
            return;
        }

        _zoom = Math.Min(ZoomMax, _zoom + ZoomStep);
        _panX = 0;
        _panY = 0;
        RevealControls();
    }

    private void ZoomOut()
    {
        if (_cropMode)
        {
            return;
        }

        _zoom = Math.Max(ZoomMin, _zoom - ZoomStep);
        _panX = 0;
        _panY = 0;
        RevealControls();
    }

    private void ResetZoom()
    {
        if (_cropMode)
        {
            return;
        }

        _zoom = ZoomDefault;
        _panX = 0;
        _panY = 0;
        RevealControls();
    }

    private async Task StartPanAsync(PointerEventArgs args)
    {
        RevealControls();
        if (_cropMode || _module is null || _zoom <= ZoomDefault || !args.IsPrimary)
        {
            return;
        }

        var size = await _module.InvokeAsync<ElementSize>("measureAndCaptureElement", _viewport, args.PointerId);
        _pan = new PanSession(args.PointerId, args.ClientX, args.ClientY, _panX, _panY, size.Width, size.Height);
    }

    private void MovePan(PointerEventArgs args)
    {
        if (_cropMode)
        {
            MoveCropDrag(args);
            return;
        }

        if (_pan is null || _pan.PointerId != args.PointerId)
        {
            return;
        }

        var maxPanX = _pan.ViewportWidth * (_zoom - 1) / 2;
        var maxPanY = _pan.ViewportHeight * (_zoom - 1) / 2;
        _panX = Math.Clamp(_pan.StartPanX + (args.ClientX - _pan.StartClientX), -maxPanX, maxPanX);
        _panY = Math.Clamp(_pan.StartPanY + (args.ClientY - _pan.StartClientY), -maxPanY, maxPanY);
    }

    private async Task EndPanAsync(PointerEventArgs args)
    {
        if (_cropMode)
        {
            await EndCropDragAsync(args);
            return;
        }

        if (_pan is null || _pan.PointerId != args.PointerId)
        {
            return;
        }

        _pan = null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releasePointer", _viewport, args.PointerId);
        }
    }

    private async Task ToggleCropModeAsync()
    {
        if (!CanCropCurrentImage)
        {
            return;
        }

        if (_cropMode)
        {
            CancelCrop();
        }
        else
        {
            await EnterCropModeAsync();
        }
    }

    private async Task EnterCropModeAsync()
    {
        if (!CanCropCurrentImage)
        {
            return;
        }

        CancelControlsHideTimer();
        var wasTransformed = _zoom > ZoomDefault || _panX != 0 || _panY != 0;
        _zoom = ZoomDefault;
        _panX = 0;
        _panY = 0;
        _cropRect = DefaultCropRect;
        _cropError = null;
        _cropSaving = false;
        _cropDrag = null;
        _cropImageBounds = null;
        _cropMode = true;
        _controlsVisible = true;
        await InvokeAsync(StateHasChanged);

        if (wasTransformed)
        {
            await Task.Delay(220);
        }

        await MeasureCropBoundsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void CancelCrop()
    {
        ExitCropModeState();
        RevealControls();
    }

    private void ExitCropModeState()
    {
        _cropMode = false;
        _cropDrag = null;
        _cropRect = null;
        _cropImageBounds = null;
        _cropError = null;
        _cropSaving = false;
    }

    private async Task MeasureCropBoundsAsync()
    {
        if (_module is null)
        {
            return;
        }

        _cropImageBounds = await _module.InvokeAsync<ImageRenderBounds?>("measureRenderedImage", _viewport);
    }

    private async Task StartCropDragAsync(CropHandle handle, PointerEventArgs args)
    {
        if (!_cropMode || _cropRect is null || _cropImageBounds is null || !args.IsPrimary || _module is null)
        {
            return;
        }

        RevealControls();
        await _module.InvokeVoidAsync("measureAndCaptureElement", _viewport, args.PointerId);
        _cropDrag = new CropDragSession(args.PointerId, handle, args.ClientX, args.ClientY, _cropRect, _cropImageBounds);
    }

    private void MoveCropDrag(PointerEventArgs args)
    {
        if (_cropDrag is null || _cropDrag.PointerId != args.PointerId)
        {
            return;
        }

        var bounds = _cropDrag.Bounds;
        if (bounds.RenderedWidth <= 0 || bounds.RenderedHeight <= 0)
        {
            return;
        }

        var dxPercent = (args.ClientX - _cropDrag.StartClientX) / bounds.RenderedWidth * 100;
        var dyPercent = (args.ClientY - _cropDrag.StartClientY) / bounds.RenderedHeight * 100;
        _cropRect = ApplyCropDrag(_cropDrag.Handle, _cropDrag.StartRect, dxPercent, dyPercent);
    }

    private async Task EndCropDragAsync(PointerEventArgs args)
    {
        if (_cropDrag is null || _cropDrag.PointerId != args.PointerId)
        {
            return;
        }

        _cropDrag = null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releasePointer", _viewport, args.PointerId);
        }
    }

    private static CropRect ApplyCropDrag(CropHandle handle, CropRect start, double dxPercent, double dyPercent)
    {
        var (x, width) = AdjustHorizontal(handle, start, dxPercent);
        var (y, height) = AdjustVertical(handle, start, dyPercent);
        return new CropRect(x, y, width, height);
    }

    private static (double X, double Width) AdjustHorizontal(CropHandle handle, CropRect start, double dxPercent) => handle switch
    {
        CropHandle.E or CropHandle.NE or CropHandle.SE =>
            (start.XPercent, Math.Clamp(start.WidthPercent + dxPercent, CropMinSizePercent, 100 - start.XPercent)),
        CropHandle.W or CropHandle.NW or CropHandle.SW => AdjustLeftEdge(start, dxPercent),
        CropHandle.Body => (Math.Clamp(start.XPercent + dxPercent, 0, 100 - start.WidthPercent), start.WidthPercent),
        _ => (start.XPercent, start.WidthPercent)
    };

    private static (double X, double Width) AdjustLeftEdge(CropRect start, double dxPercent)
    {
        var newX = Math.Clamp(start.XPercent + dxPercent, 0, start.XPercent + start.WidthPercent - CropMinSizePercent);
        return (newX, start.XPercent + start.WidthPercent - newX);
    }

    private static (double Y, double Height) AdjustVertical(CropHandle handle, CropRect start, double dyPercent) => handle switch
    {
        CropHandle.S or CropHandle.SE or CropHandle.SW =>
            (start.YPercent, Math.Clamp(start.HeightPercent + dyPercent, CropMinSizePercent, 100 - start.YPercent)),
        CropHandle.N or CropHandle.NE or CropHandle.NW => AdjustTopEdge(start, dyPercent),
        CropHandle.Body => (Math.Clamp(start.YPercent + dyPercent, 0, 100 - start.HeightPercent), start.HeightPercent),
        _ => (start.YPercent, start.HeightPercent)
    };

    private static (double Y, double Height) AdjustTopEdge(CropRect start, double dyPercent)
    {
        var newY = Math.Clamp(start.YPercent + dyPercent, 0, start.YPercent + start.HeightPercent - CropMinSizePercent);
        return (newY, start.YPercent + start.HeightPercent - newY);
    }

    private async Task ConfirmCropAsync()
    {
        if (_cropRect is null || _cropImageBounds is null || _cropSaving || !CanCropCurrentImage)
        {
            return;
        }

        var bounds = _cropImageBounds;
        if (bounds.NaturalWidth <= 0 || bounds.NaturalHeight <= 0)
        {
            _cropError = "The image could not be measured. Try again.";
            return;
        }

        var rect = _cropRect;
        var x = (int)Math.Round(rect.XPercent / 100 * bounds.NaturalWidth);
        var y = (int)Math.Round(rect.YPercent / 100 * bounds.NaturalHeight);
        var width = (int)Math.Round(rect.WidthPercent / 100 * bounds.NaturalWidth);
        var height = (int)Math.Round(rect.HeightPercent / 100 * bounds.NaturalHeight);
        x = Math.Clamp(x, 0, (int)bounds.NaturalWidth - 1);
        y = Math.Clamp(y, 0, (int)bounds.NaturalHeight - 1);
        width = Math.Clamp(width, 1, (int)bounds.NaturalWidth - x);
        height = Math.Clamp(height, 1, (int)bounds.NaturalHeight - y);

        _cropSaving = true;
        _cropError = null;
        StateHasChanged();

        var image = Images[_currentIndex];
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(image.Id)}/crop",
                new { X = x, Y = y, Width = width, Height = height });

            if (response.IsSuccessStatusCode)
            {
                ExitCropModeState();
                RevealControls();
            }
            else
            {
                _cropError = response.StatusCode switch
                {
                    HttpStatusCode.NotFound => "The image could not be found. It may have been moved or removed.",
                    HttpStatusCode.BadRequest => "The selected region is invalid. Adjust it and try again.",
                    _ => "The crop could not be saved. Try again."
                };
            }
        }
        catch (HttpRequestException)
        {
            _cropError = "The crop could not be saved. Check your connection and try again.";
        }
        finally
        {
            _cropSaving = false;
        }
    }

    private static string CropOverlayContainerStyle(ImageRenderBounds bounds) => FormattableString.Invariant(
        $"left: {bounds.OffsetX:0.##}px; top: {bounds.OffsetY:0.##}px; width: {bounds.RenderedWidth:0.##}px; height: {bounds.RenderedHeight:0.##}px;");

    private static string CropRectStyle(CropRect rect) => FormattableString.Invariant(
        $"left: {rect.XPercent:0.##}%; top: {rect.YPercent:0.##}%; width: {rect.WidthPercent:0.##}%; height: {rect.HeightPercent:0.##}%;");

    private static string CropActionsStyle(CropRect rect)
    {
        var showBelow = rect.YPercent < 15;
        var top = showBelow
            ? FormattableString.Invariant($"calc({rect.YPercent + rect.HeightPercent:0.##}% + 0.5rem)")
            : FormattableString.Invariant($"calc({rect.YPercent:0.##}% - 2.75rem)");
        return FormattableString.Invariant($"left: {rect.XPercent:0.##}%; top: {top};");
    }

    private void HandleSaturationInput(ChangeEventArgs args)
    {
        if (_cropMode)
        {
            return;
        }

        if (double.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), NumberStyles.Float,
                CultureInfo.InvariantCulture, out var value))
        {
            _saturation.SetValue(value);
        }
    }

    private void ResetSaturation()
    {
        if (_cropMode)
        {
            return;
        }

        _saturation.Reset();
    }

    private static string Invariant(double value) => value.ToString("0", CultureInfo.InvariantCulture);

    private static bool IsCropSupported(string imageName) =>
        Path.GetExtension(imageName) is var extension &&
        (string.Equals(extension, ".jpg", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(extension, ".jpeg", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(extension, ".png", StringComparison.OrdinalIgnoreCase));

    private static string ToggleCssClass(bool active) => active
        ? "btn-primary d-inline-flex align-items-center justify-content-center p-2"
        : ActionCssClass;

    private void HandleControlHoverStarted()
    {
        _controlHoverActive = true;
        _controlsVisible = true;
        CancelControlsHideTimer();
    }

    private void HandleControlHoverEnded()
    {
        _controlHoverActive = false;
        ArmControlsHideTimer();
    }

    private void RevealControls()
    {
        _controlsVisible = true;
        ArmControlsHideTimer();
    }

    private void ArmControlsHideTimer()
    {
        CancelControlsHideTimer();
        if (_disposed || _controlHoverActive)
        {
            return;
        }

        _controlsHideCancellation = new CancellationTokenSource();
        _ = HideControlsAfterDelayAsync(_controlsHideCancellation.Token);
    }

    private async Task HideControlsAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(ControlHideDelaySeconds), cancellationToken);
            await InvokeAsync(() =>
            {
                if (!_controlHoverActive)
                {
                    _controlsVisible = false;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelControlsHideTimer()
    {
        _controlsHideCancellation?.Cancel();
        _controlsHideCancellation?.Dispose();
        _controlsHideCancellation = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelControlsHideTimer();
        _fillTab.Exit();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("removeArrowKeyNavigation");
                await _module.InvokeVoidAsync("exitFillTab");
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
    }

    private enum CropHandle { Body, N, S, E, W, NE, NW, SE, SW }

    private sealed record CropRect(double XPercent, double YPercent, double WidthPercent, double HeightPercent);

    private sealed record ImageRenderBounds(
        double OffsetX, double OffsetY, double RenderedWidth, double RenderedHeight, double NaturalWidth, double NaturalHeight);

    private sealed record CropDragSession(
        long PointerId, CropHandle Handle, double StartClientX, double StartClientY, CropRect StartRect, ImageRenderBounds Bounds);

    private sealed record ElementSize(double Width, double Height);

    private sealed record PanSession(long PointerId, double StartClientX, double StartClientY,
        double StartPanX, double StartPanY, double ViewportWidth, double ViewportHeight);
