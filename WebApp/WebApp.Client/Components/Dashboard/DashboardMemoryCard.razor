@inject HttpClient Http
@implements IDisposable
@using WebApp.Client.Models

<div class="card h-100">
    <div class="card-body">
        <h2 class="h6 card-title d-flex align-items-center gap-2">
            <i class="bi bi-memory" aria-hidden="true"></i>Memory
        </h2>
        @if (_isLoading)
        {
            <p class="small text-body-secondary mb-0" aria-live="polite">Loading&hellip;</p>
        }
        else if (_metrics is null || !_metrics.IsAvailable)
        {
            <p class="small text-body-secondary mb-0">Memory metrics unavailable</p>
        }
        else
        {
            <div class="mb-2">
                <div class="d-flex justify-content-between small mb-1">
                    <span>RAM</span>
                    <span class="@ThresholdColor.TextClass(RamPercent)">@DashboardFormat.Bytes(_metrics.UsedBytes) of @DashboardFormat.Bytes(_metrics.TotalBytes)</span>
                </div>
                <div class="progress" role="progressbar" aria-label="RAM used"
                     aria-valuenow="@DashboardFormat.CssPercent(RamPercent)" aria-valuemin="0" aria-valuemax="100" style="height: 6px;">
                    <div class="progress-bar @ThresholdColor.ProgressBarClass(RamPercent)" style="width: @DashboardFormat.CssPercent(RamPercent)%;"></div>
                </div>
            </div>
            <dl class="row small mb-0">
                <dt class="col-7">Available</dt>
                <dd class="col-5 text-end">@DashboardFormat.Bytes(_metrics.AvailableBytes)</dd>
                <dt class="col-7">Page cache</dt>
                <dd class="col-5 text-end">@DashboardFormat.Bytes(_metrics.CachedBytes)</dd>
                <dt class="col-7">Swap</dt>
                <dd class="col-5 text-end">@DashboardFormat.Bytes(_metrics.SwapUsedBytes) of @DashboardFormat.Bytes(_metrics.SwapTotalBytes)</dd>
            </dl>
        }
    </div>
</div>

@code {
    private DashboardMemoryDto? _metrics;
    private bool _isLoading = true;
    private CancellationTokenSource? _cts;

    private double? RamPercent =>
        _metrics is { TotalBytes: > 0, UsedBytes: not null }
            ? _metrics.UsedBytes!.Value * 100.0 / _metrics.TotalBytes!.Value
            : null;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _isLoading = true;
        StateHasChanged();

        try
        {
            _metrics = await Http.GetFromJsonAsync<DashboardMemoryDto>("api/dashboard/memory", _cts.Token);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            _metrics = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
