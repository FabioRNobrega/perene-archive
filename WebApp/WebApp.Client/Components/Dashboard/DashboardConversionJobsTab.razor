@inject HttpClient Http
@using WebApp.Client.Models
@implements IAsyncDisposable

@if (_rows.Count == 0)
{
    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center text-body-secondary py-5"><i class="bi bi-list-task display-6 mb-3" aria-hidden="true"></i><p class="mb-0">No jobs have been recorded yet.</p></div>
}
else
{
    <section class="d-flex flex-column h-100 min-h-0" aria-label="Jobs">
        <div class="flex-shrink-0">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap"><div><h1 class="h4 mb-1">Jobs</h1><p class="text-body-secondary mb-0">@_rows.Count job@(_rows.Count == 1 ? string.Empty : "s") recorded.</p></div><button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" type="button" @onclick="RefreshAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Refresh jobs</button></div>
            <div class="btn-group flex-wrap mb-3" role="group" aria-label="Filter jobs by type">
                @foreach (var (key, label) in JobListRules.Filters)
                {
                    <button type="button" class="btn btn-sm @(_filter == key ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(_filter == key ? "true" : "false")" @onclick="@(() => SetFilter(key))">@label <span class="badge text-bg-light ms-1">@JobListRules.CountFor(_rows, key)</span></button>
                }
            </div>
            @if (_controlError is not null) { <div class="alert alert-warning" role="alert">@_controlError</div> }
        </div>
        <div class="flex-grow-1 min-h-0 overflow-y-auto">
            @if (_visible.Count == 0)
            {
                <p class="text-body-secondary">No jobs of this type.</p>
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var row in _page)
                    {
                        <JobRow @key="row.Id" Row="row" Expanded="_expanded.Contains(row.Id)" Busy="@(_controlBusyJobId is not null)" OnToggle="Toggle" OnPause="TogglePauseAsync" OnStop="@(r => { _stopConfirmation = r.Conversion; return Task.CompletedTask; })" OnRetry="RetryAsync" />
                    }
                </ul>
            }
        </div>
        @if (_visible.Count > JobListRules.PageSizes.Min())
        {
            <nav class="flex-shrink-0 d-flex align-items-center flex-wrap gap-3 pt-2" aria-label="Jobs pages">
                @if (_pageCount > 1)
                {
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_pageNumber == 1 ? "disabled" : null)"><button class="page-link" type="button" aria-label="Previous page" disabled="@(_pageNumber == 1)" @onclick="@(() => GoTo(_pageNumber - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>
                        @foreach (var number in JobListRules.PageWindow(_pageNumber, _visible.Count, _pageSize))
                        {
                            <li class="page-item @(number == _pageNumber ? "active" : null)"><button class="page-link" type="button" aria-label="Page @number" aria-current="@(number == _pageNumber ? "page" : null)" @onclick="@(() => GoTo(number))">@number</button></li>
                        }
                        <li class="page-item @(_pageNumber == _pageCount ? "disabled" : null)"><button class="page-link" type="button" aria-label="Next page" disabled="@(_pageNumber == _pageCount)" @onclick="@(() => GoTo(_pageNumber + 1))"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>
                    </ul>
                }
                <div class="d-flex align-items-center gap-2"><label class="small text-body-secondary mb-0" for="jobs-page-size">Per page</label><select id="jobs-page-size" class="form-select form-select-sm w-auto" value="@_pageSize" @onchange="SetPageSize">@foreach (var size in JobListRules.PageSizes) { <option value="@size" selected="@(size == _pageSize)">@size</option> }</select></div>
                <span class="small text-body-secondary">@((_pageNumber - 1) * _pageSize + 1)–@(Math.Min(_pageNumber * _pageSize, _visible.Count)) of @_visible.Count</span>
            </nav>
        }
    </section>
}

@if (_stopConfirmation is { } stopJob)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="conversion-stop-modal-label" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h1 class="modal-title fs-5" id="conversion-stop-modal-label">Stop conversion?</h1><button class="btn-close" type="button" aria-label="Close" @onclick="CancelStop" disabled="@(_controlBusyJobId is not null)"></button></div><div class="modal-body"><p>Stop the current process for <strong class="text-break">@stopJob.SourceName</strong>?</p><p class="mb-0">Temporary files generated for this job will be deleted. The original source will not be changed.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" @onclick="CancelStop" disabled="@(_controlBusyJobId is not null)">Cancel</button><button class="btn btn-danger" type="button" @onclick="ConfirmStopAsync" disabled="@(_controlBusyJobId is not null)">Stop conversion</button></div></div></div>
    </div><div class="modal-backdrop fade show"></div>
}

@code {
    private IReadOnlyList<JobRowModel> _rows = [];
    private IReadOnlyList<JobRowModel> _visible = [];
    private IReadOnlyList<JobRowModel> _page = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private string _filter = "all";
    private int _pageNumber = 1;
    private int _pageSize = JobListRules.DefaultPageSize;
    private int _pageCount = 1;
    private CancellationTokenSource? _pollingCts;
    private VideoConversionJobDto? _stopConfirmation;
    private string? _controlBusyJobId;
    private string? _controlError;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        IReadOnlyList<VideoConversionJobDto> conversions = [];
        IReadOnlyList<JobSummaryDto> others = [];
        try { conversions = await Http.GetFromJsonAsync<List<VideoConversionJobDto>>("api/dashboard/jobs") ?? []; } catch (HttpRequestException) { }
        try { others = await Http.GetFromJsonAsync<List<JobSummaryDto>>("api/dashboard/jobs/activity") ?? []; } catch (HttpRequestException) { }
        _rows = JobListRules.Order(JobListRules.Build(conversions, others));
        Recompute();
        UpdatePolling();
    }

    // Filtering, paging and the open-details set are derived from the latest rows, so a refresh never closes a panel you opened.
    private void Recompute()
    {
        _visible = _rows.Where(row => JobListRules.Matches(row, _filter)).ToList();
        _pageNumber = JobListRules.ClampPage(_pageNumber, _visible.Count, _pageSize);
        _pageCount = JobListRules.PageCount(_visible.Count, _pageSize);
        _page = JobListRules.Page(_visible, _pageNumber, _pageSize);
        _expanded.IntersectWith(_rows.Select(row => row.Id));
    }

    private void SetFilter(string key) { _filter = key; _pageNumber = 1; Recompute(); }
    private void SetPageSize(ChangeEventArgs e) { _pageSize = JobListRules.NormalizePageSize(int.TryParse(e.Value?.ToString(), out var size) ? size : JobListRules.DefaultPageSize); _pageNumber = 1; Recompute(); }
    private void GoTo(int page) { _pageNumber = page; Recompute(); }
    private void Toggle(string id) { if (!_expanded.Remove(id)) _expanded.Add(id); }

    private void UpdatePolling() { if (_rows.Any(row => row.IsActive)) { if (_pollingCts is null) { _pollingCts = new(); _ = PollAsync(_pollingCts.Token); } return; } _pollingCts?.Cancel(); _pollingCts = null; }
    private async Task PollAsync(CancellationToken token) { try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); while (await timer.WaitForNextTickAsync(token)) { await RefreshAsync(); await InvokeAsync(StateHasChanged); if (!_rows.Any(row => row.IsActive)) break; } } catch (OperationCanceledException) { } }

    private Task TogglePauseAsync(JobRowModel row) => ControlAsync(row.Id, row.State == "Paused" ? "resume" : "pause", "This conversion changed state before the request completed.");
    private async Task RetryAsync(JobRowModel row) => await ControlAsync(row.Id, "retry", "This conversion could not be retried.", readServerError: true);
    private void CancelStop() => _stopConfirmation = null;
    private async Task ConfirmStopAsync() { if (_stopConfirmation is not { } job) return; _stopConfirmation = null; await ControlAsync(job.JobId, "stop", "This conversion changed state before the request completed."); }

    private async Task ControlAsync(string jobId, string action, string failureMessage, bool readServerError = false)
    {
        _controlBusyJobId = jobId; _controlError = null;
        try
        {
            using var response = await Http.PostAsync($"api/dashboard/jobs/{jobId}/{action}", null);
            if (!response.IsSuccessStatusCode) _controlError = (readServerError ? await ReadErrorAsync(response) : null) ?? failureMessage;
        }
        catch (HttpRequestException) { _controlError = "The request could not be completed."; }
        finally { _controlBusyJobId = null; await RefreshAsync(); }
    }

    private static async Task<string?> ReadErrorAsync(HttpResponseMessage response) { try { return (await response.Content.ReadFromJsonAsync<Dictionary<string, string>>())?.GetValueOrDefault("error"); } catch (Exception e) when (e is System.Text.Json.JsonException or NotSupportedException) { return null; } }

    public ValueTask DisposeAsync() { _pollingCts?.Cancel(); _pollingCts?.Dispose(); return ValueTask.CompletedTask; }
}
