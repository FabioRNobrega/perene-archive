@inject HttpClient Http
@using WebApp.Client.Models
@implements IAsyncDisposable

@if (_jobs.Count == 0)
{
    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center text-body-secondary py-5"><i class="bi bi-arrow-repeat display-6 mb-3" aria-hidden="true"></i><p class="mb-0">No conversion jobs have been submitted during this application session.</p></div>
}
else
{
    <section aria-label="Conversion jobs">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap"><div><h1 class="h4 mb-1">Conversion jobs</h1><p class="text-body-secondary mb-0">@_jobs.Count job@(_jobs.Count == 1 ? string.Empty : "s") submitted in this application session.</p></div><button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" type="button" @onclick="RefreshAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Refresh jobs</button></div>
        @if (_controlError is not null) { <div class="alert alert-warning" role="alert">@_controlError</div> }
        <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-3">
            @foreach (var job in _jobs)
            {
                var progress = ProgressPercent(job);
                <div class="col" @key="job.JobId"><article class="card h-100 shadow-sm"><div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex align-items-start justify-content-between gap-3"><div class="flex-grow-1"><p class="text-body-secondary text-uppercase small fw-semibold mb-1">Source</p><h2 class="h6 text-break mb-0">@job.SourceName</h2></div><span class="badge @Badge(job.State) flex-shrink-0">@if (IsActive(job) && job.State != VideoConversionJobState.Paused) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }@job.State</span></div>
                    @if (IsActive(job))
                    {
                        <div><div class="d-flex justify-content-between small mb-1"><span>@ProgressLabel(job)</span><strong>@progress.ToString("0")%</strong></div><div class="progress" role="progressbar" aria-label="Conversion progress for @job.SourceName" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" style="height: .65rem;"><div class="progress-bar progress-bar-striped @(job.State == VideoConversionJobState.Paused ? string.Empty : "progress-bar-animated")" style="width: @($"{progress:0.#}%")"></div></div><div class="d-flex flex-wrap gap-3 small text-body-secondary mt-2"><span>Started @FormatStart(job.StartedAtUtc)</span><span>Elapsed @FormatElapsed(job.StartedAtUtc)</span>@if (Remaining(job) is { } remaining) { <span>About @FormatDuration(remaining) remaining</span> }</div></div>
                    }
                    @if (job.State is VideoConversionJobState.Processing or VideoConversionJobState.Paused)
                    {
                        <div class="d-flex flex-wrap gap-2" aria-label="Controls for @job.SourceName">
                            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2" style="min-height:40px" type="button" disabled="@(_controlBusyJobId is not null)" @onclick="@(() => TogglePauseAsync(job))"><i class="bi @(job.State == VideoConversionJobState.Paused ? "bi-play-fill" : "bi-pause-fill")" aria-hidden="true"></i>@(job.State == VideoConversionJobState.Paused ? "Resume" : "Pause")</button>
                            <button class="btn btn-danger d-inline-flex align-items-center justify-content-center gap-2" style="min-height:40px" type="button" disabled="@(_controlBusyJobId is not null)" @onclick="() => _stopConfirmation = job"><i class="bi bi-stop-fill" aria-hidden="true"></i>Stop</button>
                        </div>
                    }
                    <dl class="row mb-0 small"><dt class="col-5 text-body-secondary fw-normal">Action</dt><dd class="col-7 mb-2">@job.Action</dd><dt class="col-5 text-body-secondary fw-normal">Source size</dt><dd class="col-7 mb-2">@(job.SourceSizeBytes is null ? "Unknown" : FormatSize(job.SourceSizeBytes.Value))</dd>@if (!IsActive(job)) { <dt class="col-5 text-body-secondary fw-normal">Result</dt><dd class="col-7 mb-0 text-break">@Outcome(job)</dd> }</dl>
                </div></article></div>
            }
        </div>
    </section>
}

@if (_stopConfirmation is { } stopJob)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="conversion-stop-modal-label" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h1 class="modal-title fs-5" id="conversion-stop-modal-label">Stop conversion?</h1><button class="btn-close" type="button" aria-label="Close" @onclick="CancelStop" disabled="@(_controlBusyJobId is not null)"></button></div><div class="modal-body"><p>Stop the current process for <strong class="text-break">@stopJob.SourceName</strong>?</p><p class="mb-0">Temporary files generated for this job will be deleted. The original source will not be changed.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" @onclick="CancelStop" disabled="@(_controlBusyJobId is not null)">Cancel</button><button class="btn btn-danger" type="button" @onclick="ConfirmStopAsync" disabled="@(_controlBusyJobId is not null)">Stop conversion</button></div></div></div>
    </div><div class="modal-backdrop fade show"></div>
}

@code {
    private List<VideoConversionJobDto> _jobs = [];
    private CancellationTokenSource? _pollingCts;
    private VideoConversionJobDto? _stopConfirmation;
    private string? _controlBusyJobId;
    private string? _controlError;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    public async Task RefreshAsync() { try { _jobs = await Http.GetFromJsonAsync<List<VideoConversionJobDto>>("api/dashboard/jobs") ?? []; } catch (HttpRequestException) { _jobs = []; } UpdatePolling(); }
    private void UpdatePolling() { if (_jobs.Any(IsActive)) { if (_pollingCts is null) { _pollingCts = new(); _ = PollAsync(_pollingCts.Token); } return; } _pollingCts?.Cancel(); _pollingCts = null; }
    private async Task PollAsync(CancellationToken token) { try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); while (await timer.WaitForNextTickAsync(token)) { await RefreshAsync(); await InvokeAsync(StateHasChanged); if (!_jobs.Any(IsActive)) break; } } catch (OperationCanceledException) { } }
    private static bool IsActive(VideoConversionJobDto job) => job.State is VideoConversionJobState.Pending or VideoConversionJobState.Processing or VideoConversionJobState.Paused or VideoConversionJobState.Finalizing;
    private static double ProgressPercent(VideoConversionJobDto job) => job.State == VideoConversionJobState.Completed ? 100 : job.State == VideoConversionJobState.Finalizing ? 99 : job.SourceDurationSeconds is > 0 && job.ProcessedDurationSeconds is not null ? Math.Min(99, Math.Max(0, job.ProcessedDurationSeconds.Value / job.SourceDurationSeconds.Value * 100)) : 0;
    private static TimeSpan? Remaining(VideoConversionJobDto job) => job.State == VideoConversionJobState.Processing && job.SourceDurationSeconds is > 0 && job.ProcessedDurationSeconds is not null && job.Speed is > 0 ? TimeSpan.FromSeconds(Math.Max(0, job.SourceDurationSeconds.Value - job.ProcessedDurationSeconds.Value) / job.Speed.Value) : null;
    private static string ProgressLabel(VideoConversionJobDto job) => job.State == VideoConversionJobState.Paused ? "Paused — resume later in this application session" : job.State == VideoConversionJobState.Pending ? "Queued" : job.State == VideoConversionJobState.Finalizing ? "Validating and publishing output" : job.ProcessedDurationSeconds is not null && job.SourceDurationSeconds is not null ? $"{FormatDuration(TimeSpan.FromSeconds(job.ProcessedDurationSeconds.Value))} of {FormatDuration(TimeSpan.FromSeconds(job.SourceDurationSeconds.Value))}" : "Preparing conversion";
    private static string Badge(VideoConversionJobState s) => s switch { VideoConversionJobState.Completed => "text-bg-success", VideoConversionJobState.Failed => "text-bg-danger", VideoConversionJobState.Stopped => "text-bg-secondary", VideoConversionJobState.Skipped => "text-bg-secondary", VideoConversionJobState.Paused => "text-bg-warning", VideoConversionJobState.Finalizing => "text-bg-info", _ => "text-bg-primary" };
    private static string FormatSize(long bytes) => $"{bytes / 1024d / 1024d:0.0} MB";
    private static string FormatDuration(TimeSpan value) => value.TotalHours >= 1 ? $"{(int)value.TotalHours}:{value.Minutes:00}:{value.Seconds:00}" : $"{value.Minutes}:{value.Seconds:00}";
    private static string FormatStart(DateTimeOffset? value) => value is null ? "—" : value.Value.ToLocalTime().ToString("t");
    private static string FormatElapsed(DateTimeOffset? value) => value is null ? "—" : FormatDuration(DateTimeOffset.UtcNow - value.Value);
    private static string Outcome(VideoConversionJobDto job) => job.OutputSizeBytes is not null ? FormatSize(job.OutputSizeBytes.Value) : job.Diagnostic ?? "Waiting to start.";
    private Task TogglePauseAsync(VideoConversionJobDto job) => ControlAsync(job, job.State == VideoConversionJobState.Paused ? "resume" : "pause");
    private async Task ControlAsync(VideoConversionJobDto job, string action) { _controlBusyJobId = job.JobId; _controlError = null; try { using var response = await Http.PostAsync($"api/dashboard/jobs/{job.JobId}/{action}", null); if (!response.IsSuccessStatusCode) _controlError = "This conversion changed state before the request completed."; } catch (HttpRequestException) { _controlError = "The conversion control request could not be completed."; } finally { _controlBusyJobId = null; await RefreshAsync(); } }
    private void CancelStop() => _stopConfirmation = null;
    private async Task ConfirmStopAsync() { if (_stopConfirmation is not { } job) return; _stopConfirmation = null; await ControlAsync(job, "stop"); }
    public ValueTask DisposeAsync() { _pollingCts?.Cancel(); _pollingCts?.Dispose(); return ValueTask.CompletedTask; }
}
