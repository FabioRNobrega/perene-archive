@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@RootCssClass"
     @ref="_controlsRoot"
     role="group"
     aria-label="Video player menu"
     aria-hidden="@(!IsVisible)"
     @onpointerdown="BeginInteractionAsync"
     @onpointerdown:stopPropagation="true"
     @onpointerup="EndInteractionAsync"
     @onpointerup:stopPropagation="true"
     @onpointercancel="EndInteractionAsync"
     @onpointercancel:stopPropagation="true"
     @onmouseenter="HandleMouseEnteredAsync"
     @onmouseleave="HandleMouseLeftAsync"
     @onclick:stopPropagation="true">
    <div class="d-flex align-items-center gap-2 w-100" aria-label="Video progress">
        <output class="time-readout small text-white text-nowrap" aria-label="Elapsed time" aria-live="off">@DisplayedCurrentTime</output>
        <div class="timeline-track position-relative d-flex align-items-center flex-grow-1">
            <div class="player-progress progress position-absolute top-50 start-0 end-0 z-0 w-100 translate-middle-y"
                 aria-hidden="true">
                <div class="progress-bar" style="@ProgressStyle"></div>
            </div>
            @if (State.MarkerA is not null)
            {
                <span class="position-absolute top-0 bottom-0 z-3 translate-middle-x border-start border-2 border-success"
                      style="@MarkerStyle(State.MarkerA.Value)"
                      aria-hidden="true"></span>
            }
            @if (State.MarkerB is not null)
            {
                <span class="position-absolute top-0 bottom-0 z-3 translate-middle-x border-start border-2 border-warning"
                      style="@MarkerStyle(State.MarkerB.Value)"
                      aria-hidden="true"></span>
            }
            <input class="timeline form-range position-relative z-2 w-100 m-0"
                   type="range"
                   min="0"
                   max="@DurationValue"
                   step="0.01"
                   value="@Invariant(TimelineValue)"
                   disabled="@(!State.HasDuration)"
                   aria-label="Playback position"
                   @oninput="PreviewTimeline"
                   @onchange="CommitTimelineAsync" />
        </div>
        <span class="time-readout small text-white text-nowrap" aria-label="Total duration">@State.FormatDuration()</span>
    </div>

    <div class="btn-toolbar d-flex flex-wrap align-items-center gap-2 border-top border-light border-opacity-25 pt-2"
         role="toolbar"
         aria-label="Video player controls">
        <div class="btn-group" role="group" aria-label="Playback">
        @if (HasPlaylist)
        {
        <button class="btn @ActionCssClass"
                type="button"
                disabled="@(!CanSelectPreviousTrack)"
                aria-label="Previous track"
                title="Previous track"
                data-bs-toggle="tooltip"
                data-bs-title="Previous track"
                @onclick="HandleSelectPreviousTrackAsync">
            <i class="bi bi-chevron-compact-left" aria-hidden="true"></i>
        </button>
        }
        <button class="btn @ToggleCssClass(State.IsPlaying)"
                type="button"
                aria-label="@(State.IsPlaying ? "Pause" : "Play")"
                title="@(State.IsPlaying ? "Pause" : "Play")"
                data-bs-toggle="tooltip"
                data-bs-title="@(State.IsPlaying ? "Pause" : "Play")"
                aria-pressed="@BooleanValue(State.IsPlaying)"
                @onclick="HandleTogglePlaybackAsync">
            <i class="bi @(State.IsPlaying ? "bi-pause-fill" : "bi-play-fill")" aria-hidden="true"></i>
        </button>

        <button class="btn @ActionCssClass"
                type="button"
                aria-label="Stop"
                title="Stop"
                data-bs-toggle="tooltip"
                data-bs-title="Stop"
                @onclick="HandleStopAsync">
            <i class="bi bi-stop-fill" aria-hidden="true"></i>
        </button>

        <button class="btn @ToggleCssClass(State.IsStandardLoop)"
                type="button"
                aria-label="Repeat current video"
                title="Repeat current video"
                data-bs-toggle="tooltip"
                data-bs-title="Repeat current video"
                aria-pressed="@BooleanValue(State.IsStandardLoop)"
                @onclick="HandleToggleStandardLoopAsync">
            <i class="bi bi-repeat-1" aria-hidden="true"></i>
        </button>
        @if (HasPlaylist)
        {
        <button class="btn @ActionCssClass"
                type="button"
                disabled="@(!CanSelectNextTrack)"
                aria-label="Next track"
                title="Next track"
                data-bs-toggle="tooltip"
                data-bs-title="Next track"
                @onclick="HandleSelectNextTrackAsync">
            <i class="bi bi-chevron-compact-right" aria-hidden="true"></i>
        </button>
        }
        </div>

        <div class="btn-group" role="group" aria-label="Skip">
        <button class="btn @ActionCssClass"
                type="button"
                disabled="@(!State.HasDuration)"
                aria-label="Back 10 seconds"
                title="Back 10 seconds"
                data-bs-toggle="tooltip"
                data-bs-title="Back 10 seconds"
                @onclick="HandleSkipBackwardAsync">
            <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
        </button>
        <button class="btn @ActionCssClass"
                type="button"
                disabled="@(!State.HasDuration)"
                aria-label="Forward 10 seconds"
                title="Forward 10 seconds"
                data-bs-toggle="tooltip"
                data-bs-title="Forward 10 seconds"
                @onclick="HandleSkipForwardAsync">
            <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
        </button>
        </div>

        <div class="audio-controls d-flex align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Audio">
        <button class="btn @ToggleCssClass(State.IsMuted)"
                type="button"
                aria-label="@(State.IsMuted ? "Unmute" : "Mute")"
                title="@(State.IsMuted ? "Unmute" : "Mute")"
                data-bs-toggle="tooltip"
                data-bs-title="@(State.IsMuted ? "Unmute" : "Mute")"
                aria-pressed="@BooleanValue(State.IsMuted)"
                @onclick="HandleToggleMuteAsync">
            <i class="bi @(State.IsMuted ? "bi-volume-mute-fill" : "bi-volume-up-fill")" aria-hidden="true"></i>
        </button>
        </div>

        <label class="volume-control d-flex align-items-center gap-2">
            <span class="visually-hidden">Volume</span>
            <i class="bi bi-volume-down" aria-hidden="true"></i>
            <input class="form-range w-100 m-0" type="range"
                   min="0"
                   max="1"
                   step="0.01"
                   value="@Invariant(VolumeValue)"
                   style="@VolumeProgressStyle"
                   aria-label="Volume"
                   @oninput="PreviewVolume"
                   @onchange="CommitVolumeAsync" />
        </label>
        </div>

        <label class="rate-control">
            <span class="visually-hidden">Playback speed</span>
            <select class="form-select form-select-sm w-auto bg-dark text-white border-light"
                    value="@Invariant(State.PlaybackRate)"
                    aria-label="Playback speed"
                    @onchange="ChangeRateAsync">
                @foreach (var rate in MediaPlayerState.PlaybackRates)
                {
                    <option value="@Invariant(rate)">@Invariant(rate)x</option>
                }
            </select>
        </label>

        @if (!IsMusicMode)
        {
        <div class="btn-group" role="group" aria-label="Loop points">
        <button class="btn @ActionCssClass" type="button"
                disabled="@(!State.HasDuration)"
                aria-label="Set point A"
                title="Set point A"
                data-bs-toggle="tooltip"
                data-bs-title="Set point A · @State.FormatMarker(State.MarkerA)"
                @onclick="HandleSetMarkerAAsync">
            <i class="bi bi-chevron-bar-left" aria-hidden="true"></i>
        </button>
        <button class="btn @ActionCssClass" type="button"
                disabled="@(!State.HasDuration)"
                aria-label="Set point B"
                title="Set point B"
                data-bs-toggle="tooltip"
                data-bs-title="Set point B · @State.FormatMarker(State.MarkerB)"
                @onclick="HandleSetMarkerBAsync">
            <i class="bi bi-chevron-bar-right" aria-hidden="true"></i>
        </button>
        <button class="btn @ToggleCssClass(State.IsAbLoop)"
                type="button"
                disabled="@(!State.HasValidAbRange)"
                aria-label="Loop between A and B"
                title="Loop between A and B"
                data-bs-toggle="tooltip"
                data-bs-title="Loop A–B"
                aria-pressed="@BooleanValue(State.IsAbLoop)"
                @onclick="HandleToggleAbLoopAsync"><i class="bi bi-infinity" aria-hidden="true"></i></button>
        <button class="btn @ActionCssClass" type="button"
                disabled="@(!CanSaveCut || !State.HasValidAbRange || IsSavingCut)"
                aria-label="Save Cut"
                title="@SaveCutTitle"
                data-bs-toggle="tooltip"
                data-bs-title="@SaveCutTitle"
                @onclick="HandleSaveCutAsync">
            @if (IsSavingCut)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-download" aria-hidden="true"></i>
            }
        </button>
        <button class="btn @ActionCssClass" type="button"
                disabled="@(State.MarkerA is null && State.MarkerB is null)"
                aria-label="Clear loop points"
                title="Clear loop points"
                data-bs-toggle="tooltip"
                data-bs-title="Clear loop points"
                @onclick="HandleClearAbLoopAsync">
            <i class="bi bi-x-circle" aria-hidden="true"></i>
        </button>
        </div>
        }

        <div class="btn-group ms-auto" role="group" aria-label="Player view">
        @if (!IsMusicMode)
        {
        <button class="btn @ToggleCssClass(State.IsSubtitlesEnabled)"
                type="button"
                disabled="@(!HasSubtitles)"
                aria-label="@(State.IsSubtitlesEnabled ? "Hide subtitles" : "Show subtitles")"
                title="@(State.IsSubtitlesEnabled ? "Hide subtitles" : "Show subtitles")"
                data-bs-toggle="tooltip"
                data-bs-title="@(State.IsSubtitlesEnabled ? "Hide subtitles" : "Show subtitles")"
                aria-pressed="@BooleanValue(State.IsSubtitlesEnabled)"
                @onclick="HandleToggleSubtitlesAsync">
            <i class="bi bi-card-text" aria-hidden="true"></i>
        </button>
        }
        @if (!IsMusicMode && HasMultipleAudioTracks)
        {
        <div class="btn-group dropup" role="group">
            <button class="btn @ActionCssClass"
                    type="button"
                    disabled="@IsAudioTrackBusy"
                    aria-label="@(IsAudioTrackBusy ? "Preparing audio track" : "Audio track")"
                    title="@(IsAudioTrackBusy ? "Preparing audio track…" : "Audio track")"
                    data-bs-toggle="dropdown"
                    data-bs-boundary="viewport"
                    data-bs-strategy="fixed"
                    aria-expanded="false"
                    aria-busy="@BooleanValue(IsAudioTrackBusy)">
                @if (IsAudioTrackBusy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-translate" aria-hidden="true"></i>
                }
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-label="Audio tracks">
                @foreach (var track in AudioTracks ?? [])
                {
                    var isSelected = (State.SelectedAudioTrackIndex ?? 0) == track.Index;
                    <li>
                        <button class="dropdown-item @(isSelected ? "active" : null)"
                                type="button"
                                aria-current="@(isSelected ? "true" : null)"
                                @onclick="() => HandleSelectAudioTrackAsync(track.Index)">
                            <i class="bi @(isSelected ? "bi-check2" : "bi-translate") icon" aria-hidden="true"></i>@track.Label
                        </button>
                    </li>
                }
            </ul>
        </div>
        }
        @if (ShowPlaylistButton)
        {
        <button class="btn @ActionCssClass"
                type="button"
                aria-label="Show playlist"
                title="Show playlist"
                data-bs-toggle="tooltip"
                data-bs-title="Show playlist"
                @onclick="HandleOpenPlaylistAsync">
            <i class="bi bi-music-note-list" aria-hidden="true"></i>
        </button>
        }
        <button class="btn @ActionCssClass"
                type="button"
                aria-label="@(IsFullscreenActive ? "Exit full screen" : "Full screen")"
                title="@(IsFullscreenActive ? "Exit full screen" : "Full screen")"
                data-bs-toggle="tooltip"
                data-bs-title="@(IsFullscreenActive ? "Exit full screen" : "Full screen")"
                @onclick="HandleToggleFullscreenAsync">
            <i class="bi @(IsFullscreenActive ? "bi-arrows-angle-contract" : "bi-arrows-angle-expand")" aria-hidden="true"></i>
        </button>
        <button @ref="_fillTabButton"
                class="btn @ToggleCssClass(IsFillTabActive)"
                type="button"
                aria-label="@(IsFillTabActive ? "Exit fill browser tab" : "Fill browser tab")"
                title="@FillTabTitle"
                data-bs-toggle="tooltip"
                data-bs-title="@FillTabTitle"
                aria-pressed="@BooleanValue(IsFillTabActive)"
                @onclick="HandleEnterFillTabAsync">
            <i class="bi @FillTabIcon" aria-hidden="true"></i>
        </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(State.ValidationMessage))
    {
        <p class="alert alert-warning small py-2 px-3 mb-0" role="status" aria-live="polite">@State.ValidationMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="alert alert-danger small py-2 px-3 mb-0" role="alert" aria-live="assertive">@Error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public MediaPlayerState State { get; set; } = default!;
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback TogglePlayback { get; set; }
    [Parameter] public EventCallback<double> Seek { get; set; }
    [Parameter] public EventCallback ToggleMute { get; set; }
    [Parameter] public EventCallback<double> SetVolume { get; set; }
    [Parameter] public EventCallback<double> SetPlaybackRate { get; set; }
    [Parameter] public EventCallback ToggleStandardLoop { get; set; }
    [Parameter] public EventCallback SkipBackward { get; set; }
    [Parameter] public EventCallback SkipForward { get; set; }
    [Parameter] public EventCallback SetMarkerA { get; set; }
    [Parameter] public EventCallback SetMarkerB { get; set; }
    [Parameter] public EventCallback ToggleAbLoop { get; set; }
    [Parameter] public EventCallback SaveCut { get; set; }
    [Parameter] public bool IsSavingCut { get; set; }
    [Parameter] public EventCallback ClearAbLoop { get; set; }
    [Parameter] public EventCallback Stop { get; set; }
    [Parameter] public EventCallback InteractionStarted { get; set; }
    [Parameter] public EventCallback InteractionEnded { get; set; }
    [Parameter] public EventCallback HoverStarted { get; set; }
    [Parameter] public EventCallback HoverEnded { get; set; }
    [Parameter] public EventCallback EnterFillTab { get; set; }
    [Parameter] public bool IsFillTabActive { get; set; }
    [Parameter] public EventCallback ToggleFullscreen { get; set; }
    [Parameter] public bool IsFullscreenActive { get; set; }
    [Parameter] public int FillTabFocusRequest { get; set; }
    [Parameter] public bool HasSubtitles { get; set; }
    [Parameter] public EventCallback ToggleSubtitles { get; set; }
    [Parameter] public bool HasMultipleAudioTracks { get; set; }
    [Parameter] public bool IsAudioTrackBusy { get; set; }
    [Parameter] public IReadOnlyList<AudioTrackDto>? AudioTracks { get; set; }
    [Parameter] public EventCallback<int> SelectAudioTrack { get; set; }
    [Parameter] public bool CanSaveCut { get; set; } = true;
    [Parameter] public bool IsMusicMode { get; set; }
    [Parameter] public bool HasPlaylist { get; set; }
    [Parameter] public bool ShowPlaylistButton { get; set; }
    [Parameter] public EventCallback OpenPlaylist { get; set; }
    [Parameter] public EventCallback SelectPreviousTrack { get; set; }
    [Parameter] public EventCallback SelectNextTrack { get; set; }
    [Parameter] public bool CanSelectPreviousTrack { get; set; }
    [Parameter] public bool CanSelectNextTrack { get; set; }
    [Parameter] public bool IsFooterMode { get; set; }

    private ElementReference _controlsRoot;
    private ElementReference _fillTabButton;
    private IJSObjectReference? _tooltipModule;
    private int _observedFillTabFocusRequest;
    private bool _timelineActive;
    private double _timelinePreview;
    private bool _volumeActive;
    private double _volumePreview;
    private bool _disposed;

    private string RootCssClass =>
        $"media-controls {(IsFooterMode ? "footer-controls" : "position-absolute bottom-0 start-0 end-0 z-3")} d-flex flex-column gap-2 text-white user-select-none {(IsVisible ? "is-visible visible opacity-100 pe-auto" : "invisible opacity-0 pe-none")}{(IsFillTabActive ? " fill-tab-controls" : string.Empty)}";
    private double TimelineValue => _timelineActive ? _timelinePreview : State.CurrentTime;
    private double VolumeValue => _volumeActive ? _volumePreview : State.Volume;
    private string DisplayedCurrentTime => MediaPlayerState.FormatTime(TimelineValue);
    private string DurationValue => Invariant(State.Duration ?? 0);
    private string ProgressStyle => $"width: {Invariant(State.Duration is > 0 ? Math.Clamp(TimelineValue / State.Duration.Value * 100, 0, 100) : 0)}%";
    private string VolumeProgressStyle => $"--volume-progress: {Invariant(Math.Clamp(VolumeValue * 100, 0, 100))}%";
    private string SaveCutTitle => CanSaveCut ? "Save Cut" : "Save Cut is available for library videos";
    private string FillTabTitle => IsFillTabActive ? "Exit fill browser tab" : "Fill browser tab";
    private string FillTabIcon => IsFillTabActive ? "bi-arrow-bar-down" : IsFooterMode ? "bi-arrow-bar-up" : "bi-fullscreen";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _tooltipModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bootstrapInterop.js");
            }
            catch (JSException)
            {
                // Native title attributes remain available when enhanced tooltips cannot start.
            }
        }

        if (_tooltipModule is not null)
        {
            try
            {
                await _tooltipModule.InvokeVoidAsync("refreshTooltips", _controlsRoot);
            }
            catch (JSException)
            {
                // Controls stay fully operable without tooltip enhancement.
            }
        }

        if (!IsFillTabActive && FillTabFocusRequest != _observedFillTabFocusRequest)
        {
            _observedFillTabFocusRequest = FillTabFocusRequest;
            await _fillTabButton.FocusAsync();
        }
    }

    private async Task BeginInteractionAsync()
    {
        await InteractionStarted.InvokeAsync();
    }

    private async Task EndInteractionAsync()
    {
        await InteractionEnded.InvokeAsync();
    }

    private Task HandleMouseEnteredAsync() => HoverStarted.InvokeAsync();
    private Task HandleMouseLeftAsync() => HoverEnded.InvokeAsync();

    private async Task PreviewTimeline(ChangeEventArgs args)
    {
        if (TryReadDouble(args, out var value))
        {
            _timelineActive = true;
            _timelinePreview = value;
            await Seek.InvokeAsync(value);
        }
    }

    private async Task CommitTimelineAsync(ChangeEventArgs args)
    {
        if (TryReadDouble(args, out var value))
        {
            _timelinePreview = value;
            await Seek.InvokeAsync(value);
            _timelineActive = false;
        }
    }

    private void PreviewVolume(ChangeEventArgs args)
    {
        if (TryReadDouble(args, out var value))
        {
            _volumeActive = true;
            _volumePreview = value;
        }
    }

    private async Task CommitVolumeAsync(ChangeEventArgs args)
    {
        if (TryReadDouble(args, out var value))
        {
            _volumePreview = value;
            await SetVolume.InvokeAsync(value);
            _volumeActive = false;
        }
    }

    private async Task ChangeRateAsync(ChangeEventArgs args)
    {
        if (TryReadDouble(args, out var value))
        {
            await SetPlaybackRate.InvokeAsync(value);
        }
    }

    private Task HandleTogglePlaybackAsync() => TogglePlayback.InvokeAsync();
    private Task HandleToggleMuteAsync() => ToggleMute.InvokeAsync();
    private Task HandleToggleStandardLoopAsync() => ToggleStandardLoop.InvokeAsync();
    private Task HandleSelectAudioTrackAsync(int index) => SelectAudioTrack.InvokeAsync(index);

    private Task HandleToggleSubtitlesAsync() => ToggleSubtitles.InvokeAsync();
    private Task HandleSkipBackwardAsync() => SkipBackward.InvokeAsync();
    private Task HandleSkipForwardAsync() => SkipForward.InvokeAsync();
    private Task HandleSelectPreviousTrackAsync() => SelectPreviousTrack.InvokeAsync();
    private Task HandleSelectNextTrackAsync() => SelectNextTrack.InvokeAsync();
    private Task HandleOpenPlaylistAsync() => OpenPlaylist.InvokeAsync();
    private Task HandleEnterFillTabAsync() => EnterFillTab.InvokeAsync();
    private Task HandleToggleFullscreenAsync() => ToggleFullscreen.InvokeAsync();
    private Task HandleSetMarkerAAsync() => SetMarkerA.InvokeAsync();
    private Task HandleSetMarkerBAsync() => SetMarkerB.InvokeAsync();
    private Task HandleToggleAbLoopAsync() => ToggleAbLoop.InvokeAsync();
    private Task HandleSaveCutAsync() => SaveCut.InvokeAsync();
    private Task HandleClearAbLoopAsync() => ClearAbLoop.InvokeAsync();
    private Task HandleStopAsync() => Stop.InvokeAsync();

    private string MarkerStyle(double marker)
    {
        var percentage = State.Duration is > 0 ? Math.Clamp(marker / State.Duration.Value * 100, 0, 100) : 0;
        return $"left: {Invariant(percentage)}%";
    }

    private const string ActionCssClass = "btn-outline-primary d-inline-flex align-items-center justify-content-center p-2";

    private static string ToggleCssClass(bool active) => active
        ? "btn-primary d-inline-flex align-items-center justify-content-center p-2"
        : ActionCssClass;

    private static string BooleanValue(bool value) => value ? "true" : "false";
    private static string Invariant(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static bool TryReadDouble(ChangeEventArgs args, out double value) =>
        double.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), NumberStyles.Float,
            CultureInfo.InvariantCulture, out value);

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        if (_tooltipModule is null)
        {
            return;
        }

        try
        {
            await _tooltipModule.InvokeVoidAsync("disposeTooltips", _controlsRoot);
            await _tooltipModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser has already disconnected.
        }
    }
}
