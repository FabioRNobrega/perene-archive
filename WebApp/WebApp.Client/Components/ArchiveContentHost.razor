@if (_openTextDocument is not null)
{
    <FeatureErrorBoundary FeatureName="The text editor" RecoveryRequested="CloseTextDocument"><TextDocumentEditor Category="@Category" ItemId="@_openTextDocument.Id" OnClose="CloseTextDocument" /></FeatureErrorBoundary>
}
else if (_openPdfDocument is not null)
{
    <FeatureErrorBoundary FeatureName="The PDF viewer" RecoveryRequested="ClosePdfDocument"><PdfDocumentViewer Name="@_openPdfDocument.Name" PdfUrl="@(_openPdfDocument.PdfUrl ?? string.Empty)" OnClose="ClosePdfDocument" /></FeatureErrorBoundary>
}
else
{
    <FeatureErrorBoundary FeatureName="The archive browser"><ArchiveBrowser Category="@Category" Title="@Title" Icon="@Icon" OnBookSelected="OnBookSelected" OnTextDocumentSelected="OpenTextDocument" OnPdfDocumentSelected="OpenPdfDocument" /></FeatureErrorBoundary>
}

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public EventCallback<ArchiveItemDto> OnBookSelected { get; set; }
    [Parameter] public EventCallback<bool> EditorOpenChanged { get; set; }

    private ArchiveItemDto? _openTextDocument;
    private ArchiveItemDto? _openPdfDocument;

    private Task OpenTextDocument(ArchiveItemDto item)
    {
        _openTextDocument = item;
        return EditorOpenChanged.InvokeAsync(true);
    }

    private Task CloseTextDocument()
    {
        _openTextDocument = null;
        return EditorOpenChanged.InvokeAsync(false);
    }

    private Task OpenPdfDocument(ArchiveItemDto item)
    {
        _openPdfDocument = item;
        return EditorOpenChanged.InvokeAsync(true);
    }

    private Task ClosePdfDocument()
    {
        _openPdfDocument = null;
        return EditorOpenChanged.InvokeAsync(false);
    }
}
