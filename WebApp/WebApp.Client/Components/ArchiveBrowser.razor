    private static string FormatExtension(string? extension) =>
        string.IsNullOrWhiteSpace(extension) ? "FILE" : extension.TrimStart('.').ToUpperInvariant();

    private static string FormatDisplayName(ArchiveItemDto item) =>
        !string.IsNullOrWhiteSpace(item.Extension) && item.Name.EndsWith(item.Extension, StringComparison.OrdinalIgnoreCase)
            ? item.Name[..^item.Extension.Length]
            : item.Name;

    private static string FormatDuration(double? durationSeconds)
    {
        if (durationSeconds is not > 0)
        {
            return "--:--";
        }

        var duration = TimeSpan.FromSeconds(durationSeconds.Value);
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes}:{duration.Seconds:00}";
    }

    private static string FormatDimensions(int? width, int? height) =>
        width is > 0 && height is > 0 ? $"{width} x {height}" : string.Empty;

    private static string FormatResolution(int? width, int? height)
    {
        if (height is not > 0)
        {
            return "--";
        }

        return height switch
        {
            >= 2160 => "4K",
            >= 1440 => "1440p",
            >= 1080 => "1080p",
            >= 720 => "720p",
            >= 480 => "480p",
            >= 360 => "360p",
            _ => $"{width}x{height}"
        };
    }

    private static string FormatSize(long? bytes)
    {
        if (bytes is null)
        {
            return string.Empty;
        }

        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)Math.Max(0, bytes.Value);
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }

    private string GetStreamBasePath(string? audioUrl)
    {
        const string audioSuffix = "/audio";
        if (string.IsNullOrWhiteSpace(audioUrl))
        {
            return ArchiveStreamBasePath;
        }

        var path = audioUrl.StartsWith("/", StringComparison.Ordinal) ? audioUrl[1..] : audioUrl;
        return path.EndsWith(audioSuffix, StringComparison.OrdinalIgnoreCase)
            ? path[..^audioSuffix.Length]
            : path;
    }

    public void Dispose()
    {
        PlayerState.StateChanged -= HandlePlayerStateChanged;
        _mediaPollingCts?.Cancel();
        _mediaPollingCts?.Dispose();
    }

    private void RestartMediaPollingIfNeeded()
    {
        _mediaPollingCts?.Cancel();
        _mediaPollingCts?.Dispose();
        _mediaPollingCts = null;

        if (_listing?.Items.Any(item =>
                item.IsVideo &&
                (item.ThumbnailState == ThumbnailState.Pending || item.HoverPreviewState == HoverPreviewState.Pending)) != true)
        {
            return;
        }

        var currentFolderId = _listing.CurrentFolderId;
        _mediaPollingCts = new CancellationTokenSource();
        _ = PollMediaAsync(currentFolderId, _mediaPollingCts.Token);
    }

    private async Task PollMediaAsync(string? folderId, CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadAsync(folderId, restartPolling: false, showLoading: false);
                if (_listing?.Items.Any(item =>
                        item.IsVideo &&
                        (item.ThumbnailState == ThumbnailState.Pending || item.HoverPreviewState == HoverPreviewState.Pending)) != true)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

