@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public EventCallback<ArchiveItemDto> OnVideoSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnBookSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnTextDocumentSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnPdfDocumentSelected { get; set; }

    private readonly FolderForm _createFolder = new();
    private readonly FileForm _createFile = new();
    private readonly List<ArchiveUploadItemState> _uploads = [];
    private readonly Dictionary<ArchiveUploadItemState, (ElementReference Element, int FileIndex)> _uploadFileRefs = [];
    private InputFile? _fileInput;
    private InputFile? _folderInput;
    private InputFile? _resumeFileInput;
    private ArchiveUploadItemState? _resumeTarget;
    private IJSObjectReference? _uploadInteropModule;
    private ArchiveListingDto? _listing;
    private ArchiveItemDto? _renaming;
    private ArchiveItemDto? _moving;
    private bool _confirmingEmptyTrash;
    private bool _conversionQueued;
    private ArchiveItemDto? _conversionItem;
    private VideoConversionPlanDto? _conversionPlan;
    private VideoConversionSelectionDto _conversionSelection = new("compress");
    private string? _conversionPlanError;
    private string _renameName = string.Empty;
    private string? _error;
    private string? _pendingVideoSelectionId;
    private IJSObjectReference? _bootstrapModule;
    private string? _previewingVideoId;
    private List<ArchiveItemDto> _imageViewerImages = [];
    private string? _imageViewerStartId;
    private CancellationTokenSource? _mediaPollingCts;
    private bool _isLoading = true;
    private bool _operationPending;
    private string _filterText = string.Empty;

    private IReadOnlyList<ArchiveItemDto> _filteredItems =>
        string.IsNullOrWhiteSpace(_filterText)
            ? _listing?.Items ?? []
            : (_listing?.Items ?? []).Where(item => item.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase)).ToList();
    private string HeadingId => $"archive-{Category}-heading";
    private string CreateModalId => $"archive-{Category}-create-modal";
    private string CreateModalLabelId => $"archive-{Category}-create-modal-label";
    private string CreateInputId => $"archive-{Category}-create-folder";
    private string CreateFileModalId => $"archive-{Category}-create-file-modal";
    private string CreateFileModalLabelId => $"archive-{Category}-create-file-modal-label";
    private string CreateFileInputId => $"archive-{Category}-create-file";
    private string RenameModalLabelId => $"archive-{Category}-rename-modal-label";
    private string EmptyTrashModalLabelId => $"archive-{Category}-empty-trash-modal-label";
    private string ConversionQueuedModalLabelId => $"archive-{Category}-conversion-queued-modal-label";
    private string ConversionPlanModalLabelId => $"archive-{Category}-conversion-plan-modal-label";
    private string ConversionModeId => $"archive-{Category}-conversion-mode";
    private string ConversionResolutionId => $"archive-{Category}-conversion-resolution";
    private string ConversionQualityId => $"archive-{Category}-conversion-quality";
    private string RenameInputId => $"archive-{Category}-rename";
    private string ArchiveStreamBasePath => $"api/archive/{Uri.EscapeDataString(Category)}/items";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(null);
    }

    protected override void OnInitialized()
    {
        PlayerState.StateChanged += HandlePlayerStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _bootstrapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bootstrapInterop.js");
        }
        catch (JSException)
        {
            // The modal remains usable with Bootstrap's data attributes if JS interop import fails.
        }

        try
        {
            _uploadInteropModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/archiveUploadInterop.js");
        }
        catch (JSException exception)
        {
            // Uploads remain disabled (Resume/new uploads report an error) if JS interop import fails.
            Logger.LogWarning(exception, "Failed to import archiveUploadInterop.js; uploads will report an error.");
        }
    }

    private void OnFilterChanged(string value) => _filterText = value;

    private async Task LoadAsync(string? folderId, bool restartPolling = true, bool showLoading = true)
    {
        _isLoading = showLoading;
        _error = null;
        if (showLoading)
        {
            _filterText = string.Empty;
        }
        try
        {
            var url = $"api/archive/{Category}/items";
            if (!string.IsNullOrWhiteSpace(folderId))
            {
                url += $"?folderId={Uri.EscapeDataString(folderId)}";
            }

            _listing = await Http.GetFromJsonAsync<ArchiveListingDto>(url);
            if (restartPolling)
            {
                RestartMediaPollingIfNeeded();
            }

            if (showLoading && _listing?.CanCreateFolder == true)
            {
                await RestoreIncompleteUploadsAsync(folderId);
            }
        }
        catch (HttpRequestException)
        {
            _error = "The archive folder could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PlayAsPlaylist(ArchiveItemDto item) =>
        Navigation.NavigateTo($"/playlist/{Category}/{Uri.EscapeDataString(item.Id)}");

    private async Task ActivateAsync(ArchiveItemDto item)
    {
        if (item.Kind == ArchiveItemKind.Folder)
        {
            await LoadAsync(item.Id);
            return;
        }

        if (item.IsVideo && OnVideoSelected.HasDelegate)
        {
            await OnVideoSelected.InvokeAsync(item);
            return;
        }

        if (item.IsBook)
        {
            if (OnBookSelected.HasDelegate)
            {
                await OnBookSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsTextDocument)
        {
            if (OnTextDocumentSelected.HasDelegate)
            {
                await OnTextDocumentSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsPdfDocument)
        {
            if (OnPdfDocumentSelected.HasDelegate)
            {
                await OnPdfDocumentSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsVideo)
        {
            await SelectVideoAsync(item);
        }
        else if (item.IsMusic)
        {
            PlayerState.SelectMusic(item, _listing?.Items ?? []);
        }
        else if (item.IsImage)
        {
            OpenImageViewer(item);
        }
    }

    private void OpenImageViewer(ArchiveItemDto item)
    {
        _imageViewerImages = (_listing?.Items ?? [])
            .Where(candidate => candidate.IsImage)
            .ToList();
        _imageViewerStartId = item.Id;
    }

    private void CloseImageViewer()
    {
        _imageViewerImages = [];
        _imageViewerStartId = null;
    }

    private async Task SelectVideoAsync(ArchiveItemDto item)
    {
        if (!string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase))
        {
            PlayerState.SelectArchiveVideo(Category, item);
            return;
        }

        _error = null;
        _pendingVideoSelectionId = item.Id;

        try
        {
            using var response = await Http.GetAsync($"api/videos/{Uri.EscapeDataString(item.Id)}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _error = "The selected file is not available to the video player yet.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = "The video could not be prepared for playback.";
                return;
            }

            var video = await response.Content.ReadFromJsonAsync<VideoItemDto>();
            if (video is null)
            {
                _error = "The selected file is not available to the video player yet.";
                return;
            }

            PlayerState.SelectVideo(video);
        }
        catch (HttpRequestException)
        {
            _error = "The video could not be reached.";
        }
        finally
        {
            if (_pendingVideoSelectionId == item.Id)
            {
                _pendingVideoSelectionId = null;
            }
        }
    }

    private async Task OpenConversionPlanAsync(ArchiveItemDto item)
    {
        _operationPending = true; _error = null;
        try { using var response = await Http.PostAsJsonAsync($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(item.Id)}/conversion/preview", new VideoConversionSelectionDto()); if (response.IsSuccessStatusCode) { _conversionPlan = await response.Content.ReadFromJsonAsync<VideoConversionPlanDto>(); _conversionItem = item; if (_conversionPlan is not null) _conversionSelection = _conversionPlan.Selection; } else _error = "This file could not be planned for conversion."; }
        catch (HttpRequestException) { _error = "The conversion planner could not reach the server."; }
        finally { _operationPending = false; }
    }

    private async Task RecalculateConversionPlanAsync()
    {
        if (_conversionItem is null) return;
        _conversionPlanError = null; _operationPending = true;
        try { _conversionSelection.TargetSizeBytes = null; using var response = await Http.PostAsJsonAsync($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(_conversionItem.Id)}/conversion/preview", _conversionSelection); if (response.IsSuccessStatusCode) _conversionPlan = await response.Content.ReadFromJsonAsync<VideoConversionPlanDto>(); else _conversionPlanError = "That selection cannot be planned safely."; }
        catch (HttpRequestException) { _conversionPlanError = "The estimate could not be recalculated."; }
        finally { _operationPending = false; }
    }

    private async Task StartConversionAsync()
    {
        if (_conversionItem is null) return;
        _operationPending = true; _conversionPlanError = null;
        try { using var response = await Http.PostAsJsonAsync($"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(_conversionItem.Id)}/conversion", _conversionSelection); if (response.IsSuccessStatusCode) { CloseConversionPlan(); _conversionQueued = true; } else _conversionPlanError = response.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable ? "Conversion queue is full. Try again shortly." : "This conversion could not be queued."; }
        catch (HttpRequestException) { _conversionPlanError = "The conversion request could not reach the server."; }
        finally { _operationPending = false; }
    }
    private void CloseConversionPlan() { _conversionPlan = null; _conversionItem = null; _conversionPlanError = null; }
    private static string FormatDuration(double seconds) => TimeSpan.FromSeconds(seconds).TotalHours >= 1 ? TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss") : TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private void CloseConversionQueuedModal() => _conversionQueued = false;

    private bool IsSelected(ArchiveItemDto item)
    {
        if (string.Equals(_pendingVideoSelectionId, item.Id, StringComparison.Ordinal))
        {
            return true;
        }

        if (!(item.IsVideo || item.IsMusic) || !string.Equals(PlayerState.SelectedId, item.Id, StringComparison.Ordinal))
        {
            return false;
        }

        var expectedStreamBasePath = string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase)
            ? PersistentPlayerState.VideoStreamBasePath
            : item.IsMusic
                ? GetStreamBasePath(item.AudioUrl)
            : ArchiveStreamBasePath;
        return string.Equals(PlayerState.StreamBasePath, expectedStreamBasePath, StringComparison.Ordinal);
    }

    private void HandlePlayerStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CreateFolderAsync()
    {
        var folderName = _createFolder.Name.Trim();
        var listing = await SendMutationAsync(() => Http.PostAsJsonAsync(
            $"api/archive/{Category}/folders",
            new CreateFolderRequest(_listing?.CurrentFolderId, _createFolder.Name)));
        _createFolder.Name = string.Empty;

        var createdFolder = listing?.Items.FirstOrDefault(item =>
            item.Kind == ArchiveItemKind.Folder &&
            string.Equals(item.Name, folderName, StringComparison.OrdinalIgnoreCase));
        if (createdFolder is null)
        {
            return;
        }

        await HideCreateModalAsync();
        await LoadAsync(createdFolder.Id);
    }

    private void StartCreateTextFile() => StartCreateFile(".txt");

    private void StartCreateMarkdownFile() => StartCreateFile(".md");

    private void StartCreateFile(string extension)
    {
        _createFile.Extension = extension;
        _createFile.Name = string.Empty;
    }

    private async Task CreateFileAsync()
    {
        var fileName = _createFile.Name.Trim();
        var extension = _createFile.Extension;
        var listing = await SendMutationAsync(() => Http.PostAsJsonAsync(
            $"api/archive/{Category}/files",
            new CreateFileRequest(_listing?.CurrentFolderId, _createFile.Name, extension)));
        _createFile.Name = string.Empty;

        var createdFile = listing?.Items.FirstOrDefault(item =>
            item.Kind == ArchiveItemKind.File &&
            string.Equals(item.Name, $"{fileName}{extension}", StringComparison.OrdinalIgnoreCase));
        if (createdFile is null)
        {
            return;
        }

        await HideCreateFileModalAsync();
        if (OnTextDocumentSelected.HasDelegate)
        {
            await OnTextDocumentSelected.InvokeAsync(createdFile);
        }
    }

    private async Task TriggerUpload()
    {
        if (_fileInput?.Element is not { } element || _bootstrapModule is null)
        {
            return;
        }

        try
        {
            await _bootstrapModule.InvokeVoidAsync("clickElement", element);
        }
        catch (JSException)
        {
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (_fileInput?.Element is not { } inputElement)
        {
            return;
        }

        var files = e.GetMultipleFiles(e.FileCount);
        for (var index = 0; index < files.Count; index++)
        {
            var file = files[index];
            var state = new ArchiveUploadItemState { FileName = file.Name, TotalBytes = file.Size };
            _uploads.Add(state);
            _uploadFileRefs[state] = (inputElement, index);
            StateHasChanged();

            await CreateUploadSessionAsync(state, _listing?.CurrentFolderId);
        }
    }

    private async Task TriggerFolderUpload()
    {
        if (_folderInput?.Element is not { } element || _bootstrapModule is null)
        {
            return;
        }

        try
        {
            await _bootstrapModule.InvokeVoidAsync("clickElement", element);
        }
        catch (JSException)
        {
        }
    }

    private async Task OnFolderSelected(InputFileChangeEventArgs e)
    {
        if (_folderInput?.Element is not { } inputElement || _uploadInteropModule is null)
        {
            return;
        }

        var files = e.GetMultipleFiles(e.FileCount);
        var relativePaths = await _uploadInteropModule.InvokeAsync<string[]>("getRelativePaths", inputElement);

        var folderIdsByPath = new Dictionary<string, string?>(StringComparer.Ordinal) { [""] = _listing?.CurrentFolderId };

        for (var index = 0; index < files.Count; index++)
        {
            var file = files[index];
            var relativePath = index < relativePaths.Length ? relativePaths[index] : file.Name;
            var segments = relativePath.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length == 0 || segments[^1].StartsWith('.'))
            {
                continue;
            }

            var parentId = _listing?.CurrentFolderId;
            var pathSoFar = "";
            for (var segmentIndex = 0; segmentIndex < segments.Length - 1; segmentIndex++)
            {
                pathSoFar = pathSoFar.Length == 0 ? segments[segmentIndex] : $"{pathSoFar}/{segments[segmentIndex]}";
                if (!folderIdsByPath.TryGetValue(pathSoFar, out var folderId))
                {
                    folderId = await GetOrCreateFolderAsync(parentId, segments[segmentIndex]);
                    folderIdsByPath[pathSoFar] = folderId;
                }

                if (folderId is null)
                {
                    parentId = null;
                    break;
                }

                parentId = folderId;
            }

            if (parentId is null && segments.Length > 1)
            {
                continue;
            }

            var state = new ArchiveUploadItemState { FileName = segments[^1], TotalBytes = file.Size, RelativePath = relativePath };
            _uploads.Add(state);
            _uploadFileRefs[state] = (inputElement, index);
            StateHasChanged();

            await CreateUploadSessionAsync(state, parentId);
        }

        if (folderIdsByPath.Count > 1)
        {
            await LoadAsync(_listing?.CurrentFolderId, restartPolling: false, showLoading: false);
        }
    }

    private async Task<string?> GetOrCreateFolderAsync(string? parentId, string name)
    {
        try
        {
            var listingUrl = $"api/archive/{Category}/items";
            if (!string.IsNullOrWhiteSpace(parentId))
            {
                listingUrl += $"?folderId={Uri.EscapeDataString(parentId)}";
            }

            var existingListing = await Http.GetFromJsonAsync<ArchiveListingDto>(listingUrl);
            var existing = existingListing?.Items.FirstOrDefault(item =>
                item.Kind == ArchiveItemKind.Folder && string.Equals(item.Name, name, StringComparison.OrdinalIgnoreCase));
            if (existing is not null)
            {
                return existing.Id;
            }

            using var response = await Http.PostAsJsonAsync($"api/archive/{Category}/folders", new CreateFolderRequest(parentId, name));
            if (!response.IsSuccessStatusCode)
            {
                return null;
            }

            var listing = await response.Content.ReadFromJsonAsync<ArchiveListingDto>();
            return listing?.Items.FirstOrDefault(item =>
                item.Kind == ArchiveItemKind.Folder && string.Equals(item.Name, name, StringComparison.OrdinalIgnoreCase))?.Id;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to create or find folder {FolderName} under parent {ParentId}.", name, parentId);
            return null;
        }
    }

    private async Task CreateUploadSessionAsync(ArchiveUploadItemState state, string? parentId)
    {
        try
        {
            var request = new ArchiveUploadCreateRequest(parentId, state.FileName, state.TotalBytes);
            using var response = await Http.PostAsJsonAsync($"api/archive/{Category}/uploads", request);
            if (!response.IsSuccessStatusCode)
            {
                state.Status = ArchiveUploadItemStatus.Error;
                state.ErrorMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "An item with that name already exists."
                    : "This file type is not supported or could not be uploaded.";
                StateHasChanged();
                return;
            }

            var session = await response.Content.ReadFromJsonAsync<ArchiveUploadSessionDto>();
            if (session is null)
            {
                state.Status = ArchiveUploadItemStatus.Error;
                state.ErrorMessage = "The upload session could not be created.";
                StateHasChanged();
                return;
            }

            state.UploadId = session.Id;
            state.ChunkSizeBytes = session.ChunkSizeBytes;
            await RunUploadLoopAsync(state);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to create upload session for {FileName}.", state.FileName);
            state.Status = ArchiveUploadItemStatus.Error;
            state.ErrorMessage = "The upload could not reach the server.";
            StateHasChanged();
        }
    }

    private sealed class ArchiveUploadFileUnavailableException : Exception;

    // Tri-state: null = not yet determined for this page load, true/false = decided after the first chunk.
    // Chromium's SetBrowserRequestStreamingEnabled(true) requires HTTPS + HTTP/2; over the plain HTTP/1.1
    // Compose dev transport it fails outright (net::ERR_ALPN_NEGOTIATION_FAILED) rather than falling back,
    // so the very first chunk decides it for the rest of the page's lifetime and every upload thereafter
    // uses the bounded, buffered fallback directly.
    private bool? _requestStreamingSupported;

    private async Task RunUploadLoopAsync(ArchiveUploadItemState state)
    {
        if (!_uploadFileRefs.TryGetValue(state, out var fileRef) || _uploadInteropModule is null || state.UploadId is null)
        {
            Logger.LogWarning(
                "Cannot start upload chunk loop for {FileName}: fileRef present={HasFileRef}, interopModule present={HasInterop}, uploadId={UploadId}",
                state.FileName, _uploadFileRefs.ContainsKey(state), _uploadInteropModule is not null, state.UploadId);
            state.Status = ArchiveUploadItemStatus.Interrupted;
            state.ErrorMessage = "The selected file is no longer available. Reselect it to resume.";
            StateHasChanged();
            return;
        }

        state.Status = ArchiveUploadItemStatus.Uploading;
        state.StartedAt ??= DateTimeOffset.UtcNow;
        StateHasChanged();

        while (state.AcknowledgedBytes < state.TotalBytes)
        {
            var offset = state.AcknowledgedBytes;
            var remaining = state.TotalBytes - offset;
            var chunkLength = Math.Min(state.ChunkSizeBytes ?? DefaultChunkSizeBytes, remaining);

            try
            {
                var useStreaming = _requestStreamingSupported != false;
                HttpResponseMessage response;
                try
                {
                    response = await SendChunkAsync(fileRef, state, offset, chunkLength, useStreaming);
                    if (useStreaming)
                    {
                        _requestStreamingSupported = true;
                    }
                }
                catch (HttpRequestException exception) when (useStreaming && _requestStreamingSupported is null)
                {
                    Logger.LogWarning(
                        exception,
                        "Browser request streaming failed for {FileName} (likely HTTP/1.1 without TLS+HTTP/2); " +
                        "falling back to buffered chunk uploads for the rest of this page load.",
                        state.FileName);
                    _requestStreamingSupported = false;
                    response = await SendChunkAsync(fileRef, state, offset, chunkLength, useStreaming: false);
                }

                using (response)
                {
                    if (!response.IsSuccessStatusCode)
                    {
                        Logger.LogWarning(
                            "Upload chunk for {FileName} at offset {Offset} rejected with status {StatusCode}.",
                            state.FileName, offset, response.StatusCode);
                        ApplyChunkFailure(state, response.StatusCode);
                        return;
                    }

                    var dto = await response.Content.ReadFromJsonAsync<ArchiveUploadSessionDto>();
                    if (dto is null)
                    {
                        Logger.LogWarning(
                            "Upload chunk for {FileName} at offset {Offset} returned an empty confirmation body.",
                            state.FileName, offset);
                        state.Status = ArchiveUploadItemStatus.Interrupted;
                        state.ErrorMessage = "The upload could not be confirmed by the server.";
                        StateHasChanged();
                        return;
                    }

                    state.AcknowledgedBytes = dto.ReceivedBytes;
                    StateHasChanged();
                }
            }
            catch (ArchiveUploadFileUnavailableException)
            {
                Logger.LogWarning(
                    "Upload chunk slice returned null for {FileName} at offset {Offset}/{TotalBytes}.",
                    state.FileName, offset, state.TotalBytes);
                state.Status = ArchiveUploadItemStatus.Interrupted;
                state.ErrorMessage = "The selected file is no longer available. Reselect it to resume.";
                StateHasChanged();
                return;
            }
            catch (Exception exception) when (exception is HttpRequestException or IOException or JSException or TaskCanceledException)
            {
                Logger.LogWarning(
                    exception,
                    "Upload chunk for {FileName} at offset {Offset} failed with {ExceptionType}.",
                    state.FileName, offset, exception.GetType().Name);
                state.Status = ArchiveUploadItemStatus.Interrupted;
                state.ErrorMessage = "The upload was interrupted. Reselect the file to resume.";
                StateHasChanged();
                return;
            }
        }

        await FinishUploadAsync(state);
    }

    private async Task<HttpResponseMessage> SendChunkAsync(
        (ElementReference Element, int FileIndex) fileRef,
        ArchiveUploadItemState state,
        long offset,
        long chunkLength,
        bool useStreaming)
    {
        await using var streamRef = await _uploadInteropModule!.InvokeAsync<IJSStreamReference>(
            "sliceToStreamRef", fileRef.Element, fileRef.FileIndex, offset, chunkLength);
        if (streamRef is null)
        {
            throw new ArchiveUploadFileUnavailableException();
        }

        await using var sliceStream = await streamRef.OpenReadStreamAsync(chunkLength);
        var url = $"api/archive/{Category}/uploads/{Uri.EscapeDataString(state.UploadId!)}/chunk?offset={offset}&length={chunkLength}";

        if (useStreaming)
        {
            using var content = new StreamContent(sliceStream);
            using var request = new HttpRequestMessage(HttpMethod.Put, url) { Content = content };
            request.SetBrowserRequestStreamingEnabled(true);
            return await Http.SendAsync(request);
        }

        // Bounded, buffered fallback for transports without HTTPS + HTTP/2 (no browser request streaming):
        // each chunk is already size-limited by the adaptive chunk policy, so buffering one chunk in memory
        // is safe even though the whole file never is.
        var buffer = new byte[chunkLength];
        var totalRead = 0;
        while (totalRead < buffer.Length)
        {
            var read = await sliceStream.ReadAsync(buffer.AsMemory(totalRead));
            if (read == 0)
            {
                break;
            }

            totalRead += read;
        }

        using var bufferedContent = new ByteArrayContent(buffer, 0, totalRead);
        using var bufferedRequest = new HttpRequestMessage(HttpMethod.Put, url) { Content = bufferedContent };
        return await Http.SendAsync(bufferedRequest);
    }

    private void ApplyChunkFailure(ArchiveUploadItemState state, System.Net.HttpStatusCode statusCode)
    {
        var (status, message) = statusCode switch
        {
            System.Net.HttpStatusCode.Conflict =>
                (ArchiveUploadItemStatus.Interrupted, "This upload no longer matches the server offset. Reselect the file to resume."),
            System.Net.HttpStatusCode.NotFound =>
                (ArchiveUploadItemStatus.Error, "This upload session has expired. Start a new upload."),
            System.Net.HttpStatusCode.BadRequest =>
                (ArchiveUploadItemStatus.Error, "The upload could not be accepted."),
            _ => (ArchiveUploadItemStatus.Interrupted, "The upload could not reach the server. Reselect the file to resume.")
        };

        state.Status = status;
        state.ErrorMessage = message;
        StateHasChanged();
    }

    private async Task FinishUploadAsync(ArchiveUploadItemState state)
    {
        state.Status = ArchiveUploadItemStatus.Completing;
        StateHasChanged();

        try
        {
            using var response = await Http.PostAsync($"api/archive/{Category}/uploads/{Uri.EscapeDataString(state.UploadId!)}/complete", content: null);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning(
                    "Upload completion for {FileName} rejected with status {StatusCode}.", state.FileName, response.StatusCode);
                state.Status = ArchiveUploadItemStatus.Error;
                state.ErrorMessage = "The upload could not be completed.";
                StateHasChanged();
                return;
            }

            _listing = await response.Content.ReadFromJsonAsync<ArchiveListingDto>();
            state.Status = ArchiveUploadItemStatus.Done;
            _uploadFileRefs.Remove(state);
            RestartMediaPollingIfNeeded();
            StateHasChanged();
        }
        catch (HttpRequestException exception)
        {
            Logger.LogWarning(exception, "Failed to reach server to complete upload for {FileName}.", state.FileName);
            state.Status = ArchiveUploadItemStatus.Error;
            state.ErrorMessage = "The upload could not reach the server to complete.";
            StateHasChanged();
        }
    }

    private async Task RestoreIncompleteUploadsAsync(string? folderId)
    {
        try
        {
            var url = $"api/archive/{Category}/uploads";
            if (!string.IsNullOrWhiteSpace(folderId))
            {
                url += $"?parentId={Uri.EscapeDataString(folderId)}";
            }

            var sessions = await Http.GetFromJsonAsync<List<ArchiveUploadSessionDto>>(url) ?? [];
            foreach (var session in sessions)
            {
                if (_uploads.Any(existing => existing.UploadId == session.Id))
                {
                    continue;
                }

                _uploads.Add(new ArchiveUploadItemState
                {
                    FileName = session.FileName,
                    TotalBytes = session.TotalBytes,
                    UploadId = session.Id,
                    AcknowledgedBytes = session.ReceivedBytes,
                    ChunkSizeBytes = session.ChunkSizeBytes,
                    Status = ArchiveUploadItemStatus.Interrupted,
                    ErrorMessage = "Reselect the original file to resume."
                });
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private async Task StartResume(ArchiveUploadItemState state)
    {
        _resumeTarget = state;
        if (_resumeFileInput?.Element is not { } element || _bootstrapModule is null)
        {
            return;
        }

        try
        {
            await _bootstrapModule.InvokeVoidAsync("clickElement", element);
        }
        catch (JSException)
        {
        }
    }

    private async Task OnResumeFileSelected(InputFileChangeEventArgs e)
    {
        var target = _resumeTarget;
        _resumeTarget = null;
        if (target is null || _resumeFileInput?.Element is not { } inputElement)
        {
            return;
        }

        var file = e.File;
        if (!target.MatchesForResume(file.Name, file.Size))
        {
            target.ErrorMessage = "The reselected file does not match the interrupted upload's name and size.";
            StateHasChanged();
            return;
        }

        target.ErrorMessage = null;
        _uploadFileRefs[target] = (inputElement, 0);
        await RunUploadLoopAsync(target);
    }

    private async Task CancelUploadAsync(ArchiveUploadItemState state)
    {
        if (state.UploadId is not null)
        {
            try
            {
                await Http.DeleteAsync($"api/archive/{Category}/uploads/{Uri.EscapeDataString(state.UploadId)}");
            }
            catch (HttpRequestException)
            {
            }
        }

        DismissUpload(state);
        StateHasChanged();
    }

    private void DismissCompletedUploads() =>
        ArchiveUploadPreviewState.DismissCompleted(_uploads, _uploadFileRefs);

    private void DismissUpload(ArchiveUploadItemState state) =>
        ArchiveUploadPreviewState.Dismiss(state, _uploads, _uploadFileRefs);

