@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersistentPlayerState PlayerState
@inject NavigationManager Navigation
@inject ILogger<ArchiveBrowser> Logger
@implements IDisposable

<section class="card overflow-hidden" aria-labelledby="@HeadingId">
    <div class="card-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <nav id="@HeadingId" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                @if (_listing is null || _listing.Breadcrumbs.Count == 0)
                {
                    <li class="breadcrumb-item active" aria-current="page">@Title</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <button class="btn btn-link p-0 align-baseline" type="button" disabled="@_operationPending" @onclick="() => LoadAsync(null)">
                            @_listing.DisplayName
                        </button>
                    </li>
                    @foreach (var breadcrumb in _listing.Breadcrumbs)
                    {
                        var isCurrent = breadcrumb == _listing.Breadcrumbs[^1];
                        if (isCurrent)
                        {
                            <li class="breadcrumb-item active text-break" aria-current="page">@breadcrumb.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <button class="btn btn-link p-0 align-baseline text-break"
                                        type="button"
                                        disabled="@_operationPending"
                                        @onclick="() => LoadAsync(breadcrumb.FolderId)">
                                    @breadcrumb.Name
                                </button>
                            </li>
                        }
                    }
                }
            </ol>
        </nav>
        @if (_listing is not null && _listing.Items.Count > 0)
        {
            <FolderSearchBar Value="@_filterText"
                              ValueChanged="OnFilterChanged"
                              Placeholder="Filter by name"
                              AriaLabel="Filter items by name" />
        }
        @if (_listing?.CanCreateFolder == true)
        {
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-primary rounded-circle d-inline-flex align-items-center justify-content-center"
                            style="width:44px;height:44px;"
                            type="button"
                            disabled="@_operationPending"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Create">
                        <i class="bi bi-plus fs-4 lh-1" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateModalId">
                                <i class="bi bi-folder-plus me-2" aria-hidden="true"></i>
                                Folder
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    @onclick="StartCreateTextFile"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateFileModalId">
                                <i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>
                                Text file (.txt)
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    @onclick="StartCreateMarkdownFile"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateFileModalId">
                                <i class="bi bi-markdown me-2" aria-hidden="true"></i>
                                Markdown file (.md)
                            </button>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-secondary rounded-circle d-inline-flex align-items-center justify-content-center"
                        style="width:44px;height:44px;"
                        type="button"
                        disabled="@_operationPending"
                        @onclick="TriggerUpload"
                        aria-label="Upload">
                    <i class="bi bi-upload fs-5 lh-1" aria-hidden="true"></i>
                </button>
                <button class="btn btn-secondary rounded-circle d-inline-flex align-items-center justify-content-center"
                        style="width:44px;height:44px;"
                        type="button"
                        disabled="@_operationPending"
                        @onclick="TriggerFolderUpload"
                        aria-label="Upload folder">
                    <i class="bi bi-folder-plus fs-5 lh-1" aria-hidden="true"></i>
                </button>
                <InputFile @ref="_fileInput" OnChange="OnFilesSelected" multiple class="visually-hidden" aria-hidden="true" />
                <InputFile @ref="_folderInput" OnChange="OnFolderSelected" webkitdirectory directory multiple class="visually-hidden" aria-hidden="true" aria-label="Choose a folder to upload" />
                <InputFile @ref="_resumeFileInput" OnChange="OnResumeFileSelected" class="visually-hidden" aria-hidden="true" aria-label="Reselect file to resume upload" />
            </div>
        }
        @if (Category == "trash")
        {
            <button class="btn btn-danger d-inline-flex align-items-center gap-2"
                    type="button"
                    disabled="@(_operationPending || _listing is null || _listing.Items.Count == 0)"
                    aria-label="Empty Trash"
                    @onclick="StartEmptyTrash">
                <i class="bi bi-recycle" aria-hidden="true"></i>
                Empty Trash
            </button>
        }
    </div>

    @if (_uploads.Count > 0)
    {
        var uploadPreview = ArchiveUploadPreviewState.From(_uploads);
        <section class="border-top" aria-label="Upload progress preview">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap px-3 py-2 bg-body-tertiary">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <strong>Uploaded @uploadPreview.Done of @uploadPreview.Total</strong>
                    @if (uploadPreview.Pending > 0) { <span class="badge text-bg-secondary">@uploadPreview.Pending pending</span> }
                    @if (uploadPreview.Uploading > 0) { <span class="badge text-bg-secondary">@uploadPreview.Uploading uploading</span> }
                    @if (uploadPreview.Completing > 0) { <span class="badge text-bg-secondary">@uploadPreview.Completing completing</span> }
                    @if (uploadPreview.Interrupted > 0) { <span class="badge text-bg-warning">@uploadPreview.Interrupted interrupted</span> }
                    @if (uploadPreview.Error > 0) { <span class="badge text-bg-danger">@uploadPreview.Error error</span> }
                </div>
                @if (uploadPreview.CanDismissCompleted)
                {
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" type="button"
                            style="min-height: 40px;" @onclick="DismissCompletedUploads" aria-label="Dismiss completed uploads">
                        <i class="bi bi-check2-all" aria-hidden="true"></i>
                        Dismiss completed
                    </button>
                }
            </div>
            <div class="upload-progress-preview-list list-group list-group-flush">
                @foreach (var upload in _uploads)
                {
                    <div @key="upload" class="list-group-item d-flex flex-column gap-2 py-3" aria-live="polite">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span class="text-truncate fw-semibold">@(upload.RelativePath ?? upload.FileName)</span>
                        <span class="badge @UploadStatusBadgeClass(upload.Status) d-inline-flex align-items-center gap-1">
                            @if (upload.Status is ArchiveUploadItemStatus.Uploading or ArchiveUploadItemStatus.Completing)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            @UploadStatusLabel(upload.Status)
                        </span>
                    </div>
                    <div class="progress" role="progressbar"
                         aria-label="@($"Upload progress for {upload.FileName}")"
                         aria-valuenow="@upload.PercentComplete.ToString("0")" aria-valuemin="0" aria-valuemax="100"
                         style="height: 0.5rem;">
                        <div class="progress-bar @(upload.Status == ArchiveUploadItemStatus.Error ? "bg-danger" : "")"
                             style="width:@(upload.PercentComplete.ToString("0.#"))%;"></div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 small text-body-secondary">
                        <span>@FormatSize(upload.AcknowledgedBytes) / @FormatSize(upload.TotalBytes) (@upload.PercentComplete.ToString("0")%)</span>
                        @{
                            var rate = upload.ComputeBytesPerSecond(DateTimeOffset.UtcNow);
                            var eta = upload.EstimateRemaining(DateTimeOffset.UtcNow);
                        }
                        @if (rate is > 0)
                        {
                            <span>@FormatSize((long)rate.Value)/s</span>
                        }
                        @if (eta is not null && upload.Status == ArchiveUploadItemStatus.Uploading)
                        {
                            <span>ETA @FormatDuration(eta.Value.TotalSeconds)</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(upload.ErrorMessage))
                    {
                        <div class="alert alert-warning py-1 px-2 mb-0 small" role="alert">@upload.ErrorMessage</div>
                    }
                    <div class="d-flex gap-2">
                        @if (upload.Status is ArchiveUploadItemStatus.Interrupted or ArchiveUploadItemStatus.Error)
                        {
                            <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" type="button"
                                    @onclick="() => StartResume(upload)">
                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                Resume
                            </button>
                            <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" type="button"
                                    @onclick="() => CancelUploadAsync(upload)">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                                Cancel
                            </button>
                        }
                        else if (upload.Status == ArchiveUploadItemStatus.Uploading)
                        {
                            <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" type="button"
                                    @onclick="() => CancelUploadAsync(upload)">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                                Cancel
                            </button>
                        }
                        else if (upload.Status == ArchiveUploadItemStatus.Done)
                        {
                            <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" type="button"
                                    @onclick="() => DismissUpload(upload)">
                                <i class="bi bi-check2" aria-hidden="true"></i>
                                Dismiss
                            </button>
                        }
                    </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }

    @if (_isLoading)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <strong class="fs-5 text-body">Loading @Title</strong>
            <span>Reading the local archive.</span>
        </div>
    }
    else if (_listing is null || _listing.Items.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <i class="bi @Icon fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No items here</strong>
            <span>This folder is empty.</span>
        </div>
    }
    else if (_filteredItems.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <i class="bi bi-search fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No matches</strong>
            <span>No items match "@_filterText".</span>
        </div>
    }
    else
    {
        <p class="small text-body-secondary border-bottom mb-0 px-3 py-2" role="status">
            @_filteredItems.Count @(_filteredItems.Count == 1 ? "item" : "items")
        </p>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 p-3" aria-label="@Title">
            @foreach (var item in _filteredItems)
            {
                var selected = IsSelected(item);
                <div class="col">
                    <div class="card h-100 position-relative overflow-hidden @(selected ? "border-primary border-2" : null)"
                         @onmouseenter="() => StartPreview(item)"
                         @onmouseleave="ClearPreview">
                        @if (selected)
                        {
                            <span class="badge text-bg-primary position-absolute top-0 start-0 z-1 m-2">
                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Selected
                            </span>
                        }
                        <div class="dropdown position-absolute top-0 end-0 z-2 m-2" @onclick:stopPropagation="true">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-inline-flex align-items-center justify-content-center bg-body bg-opacity-75"
                                    style="width:40px;height:40px;"
                                    type="button"
                                    disabled="@_operationPending"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Actions for @item.Name">
                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (item.Kind == ArchiveItemKind.Folder && item.HasPlayableMedia)
                                {
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center"
                                                type="button"
                                                disabled="@_operationPending"
                                                @onclick="() => PlayAsPlaylist(item)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-collection-play me-2" aria-hidden="true"></i>
                                            Play as a Playlist
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                @if (item.IsConvertibleVideo && Category != "trash")
                                {
                                    <li><button class="dropdown-item d-flex align-items-center" type="button" disabled="@_operationPending" @onclick="() => OpenConversionPlanAsync(item)" @onclick:stopPropagation="true"><i class="bi bi-file-earmark-play me-2" aria-hidden="true"></i>Convert / Compress to MP4</button></li>
                                }
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            type="button"
                                            disabled="@_operationPending"
                                            @onclick="() => StartRename(item)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                                        Rename
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            type="button"
                                            disabled="@_operationPending"
                                            @onclick="() => StartMove(item)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i>
                                        Move
                                    </button>
                                </li>
                                @if (Category != "trash")
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button class="dropdown-item text-danger d-flex align-items-center"
                                                type="button"
                                                disabled="@_operationPending"
                                                @onclick="() => DeleteAsync(item)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-trash3 me-2" aria-hidden="true"></i>
                                            Move to Trash
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                        <button class="@CardButtonCssClass(item)"
                                type="button"
                                aria-pressed="@((item.IsVideo || item.IsMusic) ? selected : null)"
                                @onclick="() => ActivateAsync(item)">
                            @if (item.IsMusic)
                            {
                                <span class="archive-cover-tile ratio ratio-1x1 bg-body-tertiary w-100" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.AlbumCoverUrl))
                                    {
                                        <img src="@item.AlbumCoverUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-music-note-beamed display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@FormatDisplayName(item)</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            <span class="text-nowrap">@FormatDuration(item.DurationSeconds)</span>
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsImage)
                            {
                                <span class="archive-cover-tile ratio ratio-1x1 bg-body-tertiary w-100" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-image display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@FormatDisplayName(item)</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsBook)
                            {
                                <span class="archive-cover-tile book-cover-tile ratio w-100" style="--bs-aspect-ratio: 150%;" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.BookCoverUrl))
                                    {
                                        <img src="@item.BookCoverUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center h-100">
                                            <i class="bi bi-book display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@(item.BookTitle ?? FormatDisplayName(item))</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            @if (!string.IsNullOrWhiteSpace(item.BookAuthor))
                                            {
                                                <span class="text-truncate">@item.BookAuthor</span>
                                            }
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsVideo)
                            {
                                <span class="ratio ratio-16x9 bg-body-tertiary border-bottom w-100" aria-hidden="true">
                                    @if (item.Id == _previewingVideoId && item.HoverPreviewState == HoverPreviewState.Ready && !string.IsNullOrEmpty(item.HoverPreviewUrl))
                                    {
                                        <video src="@item.HoverPreviewUrl"
                                               poster="@item.ThumbnailUrl"
                                               class="w-100 h-100 object-fit-cover"
                                               autoplay
                                               muted
                                               loop
                                               playsinline>
                                        </video>
                                    }
                                    else if (item.ThumbnailState == ThumbnailState.Ready && !string.IsNullOrEmpty(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-film display-1 lh-1 text-body-secondary" aria-hidden="true"></i>
                                        </span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="ratio ratio-16x9 bg-body-tertiary border-bottom w-100" aria-hidden="true">
                                    <span class="d-flex align-items-center justify-content-center">
                                    <i class="bi @(item.Kind == ArchiveItemKind.Folder ? "bi-folder-fill text-primary" : FileIcon(item)) display-5" aria-hidden="true"></i>
                                    </span>
                                </span>
                            }
                            @if (!item.IsMusic && !item.IsImage && !item.IsBook)
                            {
                                <span class="card-body d-flex flex-column w-100 text-center">
                                    <span class="fw-semibold text-break">@item.Name</span>
                                    @if (item.Kind == ArchiveItemKind.File)
                                    {
                                        <span class="card-text d-flex justify-content-center gap-2 text-body-secondary mt-2 flex-wrap" style="font-size: 0.7rem;">
                                            @if (item.IsVideo)
                                            {
                                                <span class="text-nowrap">@FormatDuration(item.DurationSeconds)</span>
                                                <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                                <span class="text-nowrap">@FormatResolution(item.Width, item.Height)</span>
                                                <span class="text-nowrap">@FormatDimensions(item.Width, item.Height)</span>
                                                <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                            }
                                            else
                                            {
                                                <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                                <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                            }
                                        </span>
                                    }
                                </span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (_imageViewerStartId is not null)
{
    <ImageCarouselViewer Images="_imageViewerImages" Category="@Category" StartId="_imageViewerStartId" OnExit="CloseImageViewer" />
}

@if (_conversionQueued)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@ConversionQueuedModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@ConversionQueuedModalLabelId">Conversion queued</h1>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseConversionQueuedModal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-3">
                        <i class="bi bi-arrow-repeat fs-3 text-primary" aria-hidden="true"></i>
                        <p class="mb-0">Your conversion is working in the background. Open Jobs to follow its progress.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseConversionQueuedModal">Stay here</button>
                    <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="/?tab=jobs">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                        View Jobs
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_conversionPlan is { } plan)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@ConversionPlanModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header"><h1 class="modal-title fs-5" id="@ConversionPlanModalLabelId">Plan MP4 conversion</h1><button class="btn-close" type="button" aria-label="Close" disabled="@_operationPending" @onclick="CloseConversionPlan"></button></div>
            <div class="modal-body d-flex flex-column gap-3">
                <div class="table-responsive"><table class="table table-sm table-striped table-hover table-bordered align-middle mb-0"><thead><tr><th scope="col">Details</th><th scope="col">Input file</th><th scope="col">Output file</th></tr></thead><tbody><tr><th scope="row">Format</th><td>@plan.SourceFileType</td><td>MP4 · H.264/AAC</td></tr><tr><th scope="row">Video</th><td>@plan.VideoCodec · @plan.SourceWidth×@plan.SourceHeight</td><td>@plan.ProfileLabel · @plan.OutputWidth×@plan.OutputHeight</td></tr><tr><th scope="row">Audio</th><td>@(plan.AudioCodec ?? "None")</td><td>AAC-LC</td></tr><tr><th scope="row">Duration</th><td>@FormatDuration(plan.DurationSeconds)</td><td>@FormatDuration(plan.DurationSeconds)</td></tr><tr><th scope="row">Size</th><td>@FormatSize(plan.SourceSizeBytes)</td><td><strong>@FormatSize(plan.EstimatedSizeBytes)</strong></td></tr><tr><th scope="row">Estimated saving</th><td>—</td><td>@(plan.EstimatedSavingsBytes is null ? "Unknown" : FormatSize(plan.EstimatedSavingsBytes))</td></tr></tbody></table></div>
                <p class="small text-body-secondary mb-0">Estimated size only; actual size can vary with media complexity. @plan.Limitation</p>
                <div class="row g-3"><div class="col-md-4"><label class="form-label" for="@ConversionModeId">Mode</label><select class="form-select" id="@ConversionModeId" @bind="_conversionSelection.Mode" @bind:after="RecalculateConversionPlanAsync" disabled="@_operationPending">@foreach (var option in plan.Modes) { <option value="@option.Key">@option.Label</option> }</select></div><div class="col-md-4"><label class="form-label" for="@ConversionResolutionId">Resolution</label><select class="form-select" id="@ConversionResolutionId" @bind="_conversionSelection.OutputHeight" @bind:after="RecalculateConversionPlanAsync" disabled="@_operationPending">@foreach (var option in plan.Resolutions) { <option value="@option.Key">@option.Label@(option.Recommended ? " (recommended)" : "")</option> }</select></div><div class="col-md-4"><label class="form-label" for="@ConversionQualityId">Quality</label><select class="form-select" id="@ConversionQualityId" @bind="_conversionSelection.QualityPreset" @bind:after="RecalculateConversionPlanAsync" disabled="@_operationPending">@foreach (var option in plan.QualityPresets) { <option value="@option.Key">@option.Label</option> }</select></div></div>
                @if (_conversionPlanError is not null) { <div class="alert alert-danger mb-0" role="alert">@_conversionPlanError</div> }
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CloseConversionPlan">Cancel</button><button class="btn btn-primary" type="button" disabled="@_operationPending" @onclick="StartConversionAsync"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start conversion</button></div>
        </div></div>
    </div><div class="modal-backdrop fade show"></div>
}

