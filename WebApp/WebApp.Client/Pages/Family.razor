@page "/family"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Family · PereneArchive</PageTitle>

<header class="mb-4">
    <h1 class="h3 mb-0">Family</h1>
    <p class="text-body-secondary mb-0">Account management</p>
</header>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Your account</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-secondary" href="/account/preferences">Preferences</a>
            <a class="btn btn-outline-secondary" href="/account/change-password">Change password</a>
            <a class="btn btn-outline-secondary" href="/account/totp">Authenticator app</a>
            <a class="btn btn-outline-danger" href="/account/logout">Sign out</a>
        </div>
    </div>
</section>

<section class="card">
    <div class="card-body">
        <h2 class="h5">Users</h2>
        @if (_users is null) { <p class="text-body-secondary mb-0">Loading users…</p> }
        else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>User</th><th>Display name</th><th>Status</th><th>Authenticator</th></tr></thead><tbody>@foreach (var user in _users) { <tr><td>@user.UserName</td><td>@user.DisplayName</td><td>@(user.IsActive ? "Active" : "Inactive")</td><td>@(user.TwoFactorEnabled ? "Enabled" : "Not enabled")</td></tr> }</tbody></table></div> }
    </div>
</section>

@code {
    private List<UserDto>? _users;
    protected override async Task OnInitializedAsync() => _users = await Http.GetFromJsonAsync<List<UserDto>>("api/account/users");
    private sealed class UserDto { public string? UserName { get; set; } public string? DisplayName { get; set; } public bool IsActive { get; set; } public bool TwoFactorEnabled { get; set; } }
}
