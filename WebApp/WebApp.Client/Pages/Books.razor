@page "/books"

<PageTitle>Books · PereneArchive</PageTitle>

<header class="mb-4">
    <h1 class="h3 mb-0">Books</h1>
</header>

<ArchiveContentHost Category="books" Title="Books" Icon="bi-journal-bookmark-fill" OnBookSelected="OpenBook" />

@if (_openBookId is not null)
{
    <FeatureErrorBoundary FeatureName="The book reader" RecoveryRequested="CloseBook"><EpubReader Category="books" ItemId="@_openBookId" OnClose="CloseBook" /></FeatureErrorBoundary>
}

@code {
    private string? _openBookId;

    private void OpenBook(ArchiveItemDto item) => _openBookId = item.Id;

    private Task CloseBook() { _openBookId = null; return Task.CompletedTask; }
}
